---
import Footer from "../components/Footer.astro";
import HeadMeta from "../components/HeadMeta.astro";
import Nav from "../components/Nav.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  path?: string;
  lang?: "en" | "ar";
  dir?: "ltr" | "rtl";
  image?: string;
  pageType?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  pageHeading?: string | false;
};

const {
  title,
  description,
  path = "/",
  lang = "en",
  dir = lang === "ar" ? "rtl" : "ltr",
  image,
  pageType,
  schema,
  pageHeading = false
} = Astro.props;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <HeadMeta title={title} description={description} path={path} lang={lang} image={image} pageType={pageType} schema={schema} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{lang === "ar" ? "انتقل إلى المحتوى الرئيسي" : "Skip to main content"}</a>
    <Nav lang={lang} />
    <AnalyticsConsent lang={lang} />
    <main id="main-content">
      {pageHeading && <h1 class="sr-only">{pageHeading}</h1>}
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
