---
import { siteData, whatsappLinks } from "../data/site";
import type { Locale } from "../data/locale";
const { lang = "en" } = Astro.props as {lang?:Locale};
const ar = lang === "ar";
---
<div class="inquiry-layout">
<aside class="contact-aside"><p class="eyebrow">{ar ? "تواصل مباشر" : "Direct contact"}</p><h2>{ar ? "اختر الطريق الأسهل لك." : "Use the channel that works for you."}</h2><p>{ar ? "يمكنك الكتابة مباشرة بالبريد أو واتساب دون ملء أي نموذج." : "You can email or message directly without filling in a form."}</p><div class="direct-contact"><a class="button" href={"mailto:"+siteData.email}>{ar ? "راسلني بالبريد" : "Email me"} ↗</a><a class="button button--ghost" href={whatsappLinks.primary} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div><p><a class="text-link" href={"mailto:"+siteData.email}>{siteData.email}</a></p></aside>
<form class="inquiry-form" data-email={siteData.email} data-lang={lang}>
<p class="eyebrow">{ar ? "موجز سريع" : "A short brief"}</p>
<h2>{ar ? "إن أردت، جهّز رسالة في تطبيق بريدك." : "If useful, prepare an email in your own app."}</h2>
<p class="contact-note">{ar ? "حقلا البريد والوصف فقط مطلوبان. يفتح الموقع تطبيق بريدك ولا يرسل أو يخزن النموذج." : "Only your email and brief are required. The site opens your email app; it does not send or store the form."}</p>
<div class="field"><label for="inquiry-type">{ar ? "نوع المشروع (اختياري)" : "Project type (optional)"}</label><select id="inquiry-type" name="type"><option value="unsure">{ar ? "غير محدد" : "Not sure yet"}</option><option value="story">{ar ? "قصة أو إعلام" : "Story / media"}</option><option value="workshop">{ar ? "ورشة أو تعلم" : "Workshop / learning"}</option><option value="product">{ar ? "منتج رقمي" : "Digital product"}</option><option value="system">{ar ? "نظام عمل" : "Working system"}</option><option value="collaboration">{ar ? "تعاون آخر" : "Other collaboration"}</option></select></div>
<div class="field"><label for="inquiry-name">{ar ? "اسمك (اختياري)" : "Your name (optional)"}</label><input id="inquiry-name" name="name" autocomplete="name" maxlength="120" /></div>
<div class="field"><label for="inquiry-email">{ar ? "بريدك الإلكتروني" : "Your email"}</label><input id="inquiry-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
<div class="field"><label for="inquiry-brief">{ar ? "ما الهدف والجمهور؟" : "What is the goal and audience?"}</label><textarea id="inquiry-brief" name="brief" minlength="10" maxlength="1800" required></textarea></div>
<details><summary>{ar ? "تفاصيل إضافية (اختيارية)" : "Additional details (optional)"}</summary><div class="field"><label for="inquiry-timing">{ar ? "التوقيت" : "Timing"}</label><input id="inquiry-timing" name="timing" maxlength="120" /></div><div class="field"><label for="inquiry-context">{ar ? "روابط أو سياق" : "Links or context"}</label><textarea id="inquiry-context" name="context" maxlength="1000"></textarea></div></details>
<div class="button-row"><button class="button" type="submit">{ar ? "افتح الرسالة في البريد" : "Open in email app"}</button><button class="button button--ghost" type="button" data-copy-brief>{ar ? "انسخ الموجز" : "Copy brief"}</button></div>
<p class="form-status" role="status" aria-live="polite" hidden></p>
</form>
</div>
<script>
const form = document.querySelector('.inquiry-form');
if (form instanceof HTMLFormElement) {
  for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) {
    field.addEventListener('invalid', () => {
      const ar = form.dataset.lang === 'ar';
      field.setCustomValidity(field.validity.valueMissing ? (ar ? 'هذا الحقل مطلوب.' : 'This field is required.') : field.validity.typeMismatch ? (ar ? 'أدخل بريداً إلكترونياً صالحاً.' : 'Enter a valid email address.') : (ar ? 'اكتب وصفاً من ١٠ أحرف على الأقل.' : 'Write at least 10 characters.'));
    });
    field.addEventListener('input', () => field.setCustomValidity(''));
  }
  const allowed = new Set(['story','workshop','product','system','collaboration','unsure']);
  const type = new URLSearchParams(location.search).get('type');
  const select = form.querySelector('#inquiry-type');
  if (type && allowed.has(type) && select instanceof HTMLSelectElement) select.value = type;
  const status = form.querySelector('.form-status');
  const setStatus = (message:string) => { if (status instanceof HTMLElement) { status.hidden = false; status.textContent = message; } };
  const prepare = () => {
    if (!form.reportValidity()) return null;
    const data = new FormData(form);
    const lines = [...data.entries()].filter(([, value]) => String(value).trim()).map(([key,value]) => key + ': ' + String(value).trim());
    return lines.join('\n\n');
  };
  form.addEventListener('submit', event => {
    event.preventDefault();
    const brief = prepare(); if (!brief) return;
    const ar = form.dataset.lang === 'ar';
    const subject = ar ? 'موجز مشروع من المحفظة' : 'Portfolio project inquiry';
    window.dispatchEvent(new CustomEvent('tm:inquiry-prepared', { detail: { inquiryType: select instanceof HTMLSelectElement ? select.value : 'unsure' } }));
    location.href = 'mailto:' + form.dataset.email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(brief);
    setStatus(ar ? 'حاولنا فتح تطبيق البريد. راجع الرسالة وأرسلها من هناك؛ لم يرسل الموقع شيئاً.' : 'We tried to open your email app. Review and send there; this site has not sent anything.');
  });
  form.querySelector('[data-copy-brief]')?.addEventListener('click', async () => {
    const brief = prepare(); if (!brief) return;
    try { await navigator.clipboard.writeText(brief); setStatus(form.dataset.lang === 'ar' ? 'نُسخ الموجز. الصقه في البريد أو واتساب وأرسله بنفسك.' : 'Brief copied. Paste it into email or WhatsApp and send it yourself.'); }
    catch { setStatus(form.dataset.lang === 'ar' ? 'تعذر النسخ تلقائياً. حدّد النص وانسخه يدوياً.' : 'Automatic copy failed. Select and copy the text manually.'); }
  });
}
</script>
