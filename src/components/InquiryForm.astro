---
import {siteData,whatsappLinks} from "../data/site";import type {Locale} from "../data/locale";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";
---
<div class="inquiry-layout"><form class="inquiry-form" novalidate data-email={siteData.email} data-lang={lang}><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"/><input type="hidden" name="startedAt" value=""/>
<fieldset class="field"><legend>{ar?"ماذا تريد أن تصنع؟":"What do you want to create?"}</legend><div class="choice-grid">{[["story",ar?"قصة أو إعلام":"Story / media"],["workshop",ar?"ورشة أو تعلم":"Workshop / learning"],["product",ar?"منتج أو نظام":"Product / system"],["collaboration",ar?"تعاون":"Collaboration"],["unsure",ar?"لست متأكداً":"Not sure"]].map(([value,label])=><label><input type="radio" name="type" value={value} required/> {label}</label>)}</div></fieldset>
<div class="field"><label for="organization">{ar?"مؤسسة أم فرد؟":"Organization or individual"}</label><input id="organization" name="organization" required maxlength="120"/></div>
<div class="field"><label for="audience">{ar?"من هو الجمهور؟":"Who is the audience?"}</label><input id="audience" name="audience" required maxlength="180"/></div>
<div class="field"><label for="outcome">{ar?"ما النتيجة التي تريدها؟":"What outcome do you need?"}</label><textarea id="outcome" name="outcome" required maxlength="1200"></textarea></div>
<div class="field"><label for="timing">{ar?"التوقيت":"Timing"}</label><select id="timing" name="timing" required><option value="">{ar?"اختر":"Choose"}</option><option>{ar?"خلال شهر":"Within a month"}</option><option>{ar?"خلال ١–٣ أشهر":"1–3 months"}</option><option>{ar?"بعد ٣ أشهر":"3+ months"}</option><option>{ar?"مرن":"Flexible"}</option></select></div>
<div class="field"><label for="budget">{ar?"نطاق الميزانية (اختياري)":"Budget band (optional)"}</label><select id="budget" name="budget"><option value="">{ar?"أفضل مناقشته":"Prefer to discuss"}</option><option>Under $1,000</option><option>$1,000–$3,000</option><option>$3,000–$10,000</option><option>$10,000+</option></select></div>
<div class="field"><label for="language">{ar?"لغة التواصل":"Preferred language"}</label><select id="language" name="language" required><option>{ar?"العربية":"English"}</option><option>{ar?"الإنجليزية":"Arabic"}</option><option>{ar?"كلاهما":"Either"}</option></select></div>
<div class="field"><label for="email">{ar?"البريد الإلكتروني":"Email"}</label><input id="email" name="email" type="email" required autocomplete="email"/></div>
<div class="field"><label for="whatsapp">{ar?"واتساب (اختياري)":"WhatsApp (optional)"}</label><input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel"/></div>
<label><input type="checkbox" name="consent" required/> {ar?"أوافق على استخدام هذه المعلومات للرد على طلبي فقط.":"I agree that this information may be used only to respond to my inquiry."}</label><p class="form-error" role="alert" hidden></p><button class="button" type="submit">{ar?"جهّز رسالة البريد":"Prepare email inquiry"}</button><div class="form-status" role="status" tabindex="-1" hidden>{ar?"تم تجهيز الرسالة في تطبيق البريد. لم يرسل الموقع أي بيانات إلى خادم.":"Your inquiry has been prepared in your email app. The website did not send your data to a server."}</div></form>
<aside class="contact-aside"><p class="eyebrow">{ar?"بدائل مباشرة":"Direct alternatives"}</p><h2>{ar?"أنت تتحكم بما يتم إرساله.":"You control what gets sent."}</h2><p>{ar?"هذا النموذج يبني رسالة في تطبيق بريدك ولا يخزن بياناتك على الموقع. يمكنك أيضاً استخدام البريد أو واتساب مباشرة.":"This form builds a message in your email app and stores nothing on the site. You can also use email or WhatsApp directly."}</p><p><a class="text-link" href={`mailto:${siteData.email}`}>{siteData.email}</a></p><p><a class="text-link" href={whatsappLinks.primary} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></p></aside></div>
<script>
const form=document.querySelector('.inquiry-form');if(form instanceof HTMLFormElement){const started=form.elements.namedItem('startedAt');if(started instanceof HTMLInputElement)started.value=String(Date.now());const type=new URLSearchParams(location.search).get('type');if(type){const radio=form.querySelector(`input[name="type"][value="${CSS.escape(type)}"]`);if(radio instanceof HTMLInputElement)radio.checked=true}form.addEventListener('submit',event=>{event.preventDefault();const error=form.querySelector('.form-error');const status=form.querySelector('.form-status');const data=new FormData(form);const start=Number(data.get('startedAt'));if(data.get('website')||Date.now()-start<1500){if(error instanceof HTMLElement){error.hidden=false;error.textContent=form.dataset.lang==='ar'?'تعذر التحقق من الطلب. حاول مرة أخرى.':'Please wait a moment and try again.'}return}if(!form.checkValidity()){form.reportValidity();if(error instanceof HTMLElement){error.hidden=false;error.textContent=form.dataset.lang==='ar'?'راجع الحقول المطلوبة.':'Check the required fields.'}return}const leadType=String(data.get('type')||'unspecified');window.dispatchEvent(new CustomEvent('tm:lead',{detail:{leadType}}));const lines=[];for(const [key,value] of data.entries()){if(key!=='website'&&key!=='startedAt'&&key!=='consent'&&String(value).trim())lines.push(`${key}: ${value}`)}const subject=form.dataset.lang==='ar'?'موجز مشروع من المحفظة':'Portfolio project inquiry';location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n\n'))}`;if(error instanceof HTMLElement)error.hidden=true;if(status instanceof HTMLElement){status.hidden=false;status.focus()}})}
</script>
