---
import BaseLayout from "../layouts/BaseLayout.astro";import ProjectCard from "./ProjectCard.astro";import {projects,laneLabels} from "../data/portfolio";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";
---
<BaseLayout title={ar?"الأعمال المختارة | تامر منصور":"Selected Work | Tamer Mansour"} description={ar?"دراسات حالة مختارة في القصص والإعلام والتعلم والورشات والمنتجات والمنصات.":"Selected case studies across stories and media, learning and workshops, and products and platforms."} path={routeFor("work",lang)} lang={lang} dir={ar?"rtl":"ltr"} pageType="CollectionPage">
<header class="page-hero chapter"><p class="eyebrow">{ar?"عمل مختار، لا أرشيف كامل":"Selected, not exhaustive"}</p><h1>{ar?"أعمال تحمل دوراً ودليلاً وحدوداً واضحة.":"Work with a clear role, proof, and public boundary."}</h1><p>{ar?"خمس دراسات حالة تُظهر كيف ينتقل العمل من الفكرة إلى تجربة يمكن رؤيتها أو استخدامها.":"Five case studies show how an idea becomes an experience people can see, use, or learn from."}</p></header>
<main class="section chapter"><nav class="filter-nav" aria-label={ar?"فئات العمل":"Work categories"}>{Object.entries(laneLabels).map(([key,label])=><a href={`#${key}`}>{label[lang]}</a>)}</nav><div class="editorial-list">{(["stories","learning","products"] as const).map(lane=><section id={lane}><header class="section-heading"><p class="eyebrow">{laneLabels[lane][lang]}</p><div><h2>{laneLabels[lane][lang]}</h2></div></header><div class="project-grid">{projects.filter(project=>project.lane===lane).map(project=><ProjectCard project={project} lang={lang}/>)}</div></section>)}</div></main>
<section class="archive-invitation"><div class="chapter"><p class="eyebrow">{ar ? "الأرشيف" : "The archive"}</p><h2>{ar ? "المحفظة أوسع من دراسات الحالة الخمس." : "The portfolio is wider than five case studies."}</h2><p>{ar ? "استكشف المشاريع الإضافية والعروض التعليمية والفيديوهات الموسيقية ولوحات الاتجاه والروابط العامة." : "Explore additional projects, teaching decks, music videos, direction boards, and public links."}</p><a class="button button--light" href={withBase(routeFor("archive", lang))}>{ar ? "افتح أرشيف الأعمال" : "Open the work archive"}</a></div></section>
</BaseLayout>
