---
import BaseLayout from "../layouts/BaseLayout.astro";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";const formats=ar?[
{h:"مختبر ممارسة مسؤول",d:"جلسة عملية تربط المصادر والتحقق والمراجعة والحكم البشري بأنشطة قابلة للتطبيق.",duration:"نصف يوم أو يوم كامل"},{h:"مختبر طلاقة تفاعلي",d:"تجربة جماعية بأنشطة ودخول ونتائج ومراجعة مشتركة مصممة للطلاب أو الفرق.",duration:"٩٠ دقيقة إلى نصف يوم"},{h:"نظام تعلم مخصص",d:"ورشة مع موقع أو حزمة مصادر أو دليل متابعة يبقى بعد الجلسة.",duration:"تصميم وتسليم على مراحل"}
]:[
{h:"Responsible practice lab",d:"A hands-on session connecting sources, verification, review, and human judgment to usable activities.",duration:"Half day or full day"},{h:"Interactive fluency lab",d:"A shared experience with guided entry, activities, results, and review for students or teams.",duration:"90 minutes to half day"},{h:"Custom learning system",d:"A workshop paired with a website, source pack, or follow-up guide that remains useful after the room.",duration:"Designed and delivered in phases"}
];
---
<BaseLayout title={ar?"ورشات ومختبرات تعلم الذكاء الاصطناعي | تامر منصور":"AI Workshops and Learning Labs | Tamer Mansour"} description={ar?"ورشات عملية ثنائية اللغة تتحول إلى أنشطة ومصادر ومسارات وأدوات قابلة للاستخدام.":"Practical bilingual AI workshops that become activities, sources, workflows, and usable learning tools."} path={routeFor("workshops",lang)} lang={lang} dir={ar?"rtl":"ltr"}>
<header class="page-hero chapter"><p class="eyebrow">{ar?"ورشات عملية":"Practical workshops"}</p><h1>{ar?"الورشة لا تنتهي عند آخر شريحة.":"The workshop should outlive the last slide."}</h1><p>{ar?"أصمم تجارب تجعل الذكاء الاصطناعي ممارسة قابلة للمراجعة: أنشطة ومصادر ومسارات عمل وأدوات يمكن للناس الاحتفاظ بها.":"I design experiences that turn AI into reviewable practice: activities, source packs, workflows, and tools people can keep."}</p></header>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"ثلاثة أشكال":"Three formats"}</p><div><h2>{ar?"من جلسة مركزة إلى نظام تعلم كامل":"From a focused session to a full learning system"}</h2></div></header><div class="workshop-grid">{formats.map(item=><article class="editorial-panel"><h2>{item.h}</h2><p>{item.d}</p><p class="status">{item.duration}</p></article>)}</div></section>
<section class="evidence-band"><div class="chapter evidence-band__inner"><div><p class="eyebrow">{ar?"أمثلة عامة":"Public examples"}</p><h2>{ar?"مختبر التحقق ومختبر بيرزيت للطلاقة":"AI Verification Lab and Birzeit AI Fluency Lab"}</h2></div><div><p>{ar?"أمثلة على التدريب الذي يتحول إلى بيئة ويب ومواد ومراجعة قابلة للمعاينة. لا تُذكر أرقام حضور غير موثقة.":"Examples of training becoming a web environment, materials, and an inspectable review flow. No unsupported attendance figures are claimed."}</p><a class="button button--light" href={withBase(`${lang==="ar"?"/ar":""}/work/ai-verification-lab/`)}>{ar?"افتح دراسة الحالة":"Open the case study"}</a></div></div></section>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"ما يحتاجه التنفيذ":"Delivery details"}</p><div><h2>{ar?"لغة وجمهور وإعداد واضح":"Clear language, audience, and setup"}</h2></div></header><div class="ways-grid"><article class="editorial-panel"><h3>{ar?"الجمهور":"Audiences"}</h3><p>{ar?"جامعات ومؤسسات وفرق إعلام ومعلمون ومجتمعات وفرق مهنية.":"Universities, organizations, media teams, educators, communities, and professional teams."}</p></article><article class="editorial-panel"><h3>{ar?"اللغات والحضور":"Language and delivery"}</h3><p>{ar?"العربية أو الإنجليزية أو صيغة ثنائية. حضورياً عند الإمكان أو عن بُعد.":"Arabic, English, or bilingual. In person where possible or remote."}</p></article><article class="editorial-panel"><h3>{ar?"التخصيص":"Customization"}</h3><p>{ar?"يبدأ بموجز عن الجمهور والهدف والوقت والأجهزة والمصادر المتاحة.":"Starts with a brief covering audience, outcome, time, devices, and available sources."}</p></article></div><p><a class="button" href={withBase(`${routeFor("contact",lang)}?type=workshop`)}>{ar?"ابدأ موجز ورشة":"Start a workshop brief"}</a></p></section>
</BaseLayout>

