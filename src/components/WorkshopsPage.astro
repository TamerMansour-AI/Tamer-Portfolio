---
import BaseLayout from "../layouts/BaseLayout.astro";import {workshopProofEn} from "../data/workshops";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";const proofItems=ar?[
{title:"تدريب الذكاء الاصطناعي — مؤسسة عبد المحسن القطان",audience:"فرق ثقافية ومهنية",proof:"تدريب عملي لمدة يومين على الاستخدام المهني والإبداعي والمراجعة المسؤولة.",status:"تم التنفيذ"},
{title:"ورشات مشكال / معهد غوته للفنانين",audience:"فنانون ومبدعون بصريون",proof:"ثلاث ورشات للتطوير البصري والممارسة الفنية مع الحفاظ على الأسلوب الشخصي.",status:"تم التنفيذ"},
{title:"تدريبات المشغل للصحفيين",audience:"صحفيون وممارسو إعلام",proof:"تدريبات عملية حول التحقق وسير المحتوى والحكم التحريري البشري.",status:"تم التنفيذ"},
{title:"تدريبات WAN-IFRA لغرف الأخبار",audience:"فرق الأخبار والمحتوى",proof:"أربع تدريبات مرتبطة بتبني الذكاء الاصطناعي في سير عمل غرف الأخبار.",status:"تم التنفيذ"},
{title:"ورشة Arab Bank للأهالي",audience:"أهالٍ ودعم تعليمي",proof:"حزمة تعلم للأهالي تشمل مصادر NotebookLM وأدلة محفزات وأمثلة من الدرس إلى المادة.",status:"تم التنفيذ"},
{title:"ورشات الطلاقة في الذكاء الاصطناعي — بيرزيت",audience:"طلبة جامعيون قرب التخرج",proof:"مسارات متعددة الجلسات مع أنشطة ومكتبات محفزات ومواد استخدام مسؤول.",status:"قيد التنفيذ"},
{title:"تدريب Sharek Youth Forum للمحتوى",audience:"شباب ومجموعات تواصل",proof:"تدريب عملي على استخدام أدوات الذكاء الاصطناعي في صناعة المحتوى والتواصل.",status:"تم التنفيذ"},
{title:"العروض المتقدمة المدعومة بالذكاء الاصطناعي",audience:"فرق ومدربون ومدراء",proof:"تصميم ورشة تنتقل من الشرائح التقليدية إلى أنظمة عروض قائمة على المصادر.",status:"جاهز"}
]:workshopProofEn;const formats=ar?[
{h:"مختبر ممارسة مسؤول",d:"جلسة عملية تربط المصادر والتحقق والمراجعة والحكم البشري بأنشطة قابلة للتطبيق.",duration:"نصف يوم أو يوم كامل"},{h:"مختبر طلاقة تفاعلي",d:"تجربة جماعية بأنشطة ودخول ونتائج ومراجعة مشتركة مصممة للطلاب أو الفرق.",duration:"٩٠ دقيقة إلى نصف يوم"},{h:"نظام تعلم مخصص",d:"ورشة مع موقع أو حزمة مصادر أو دليل متابعة يبقى بعد الجلسة.",duration:"تصميم وتسليم على مراحل"}
]:[
{h:"Responsible practice lab",d:"A hands-on session connecting sources, verification, review, and human judgment to usable activities.",duration:"Half day or full day"},{h:"Interactive fluency lab",d:"A shared experience with guided entry, activities, results, and review for students or teams.",duration:"90 minutes to half day"},{h:"Custom learning system",d:"A workshop paired with a website, source pack, or follow-up guide that remains useful after the room.",duration:"Designed and delivered in phases"}
];
---
<BaseLayout title={ar?"ورشات ومختبرات تعلم الذكاء الاصطناعي | تامر منصور":"AI Workshops and Learning Labs | Tamer Mansour"} description={ar?"ورشات عملية ثنائية اللغة تتحول إلى أنشطة ومصادر ومسارات وأدوات قابلة للاستخدام.":"Practical bilingual AI workshops that become activities, sources, workflows, and usable learning tools."} path={routeFor("workshops",lang)} lang={lang} dir={ar?"rtl":"ltr"}>
<header class="page-hero chapter"><p class="eyebrow">{ar?"ورشات عملية":"Practical workshops"}</p><h1>{ar?"الورشة لا تنتهي عند آخر شريحة.":"The workshop should outlive the last slide."}</h1><p>{ar?"أصمم تجارب تجعل الذكاء الاصطناعي ممارسة قابلة للمراجعة: أنشطة ومصادر ومسارات عمل وأدوات يمكن للناس الاحتفاظ بها.":"I design experiences that turn AI into reviewable practice: activities, source packs, workflows, and tools people can keep."}</p></header>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"برامج نُفذت":"Delivered programmes"}</p><div><h2>{ar?"من القاعة إلى منصة يستمر استخدامها":"From the room to a lasting resource"}</h2></div></header><div class="project-grid"><article class="editorial-panel"><img src={withBase("/media/selected/ai-media-diploma.webp")} alt={ar?"الصفحة العامة لدبلوم الإعلام":"Public AI Media Diploma homepage"} width="900" height="600" loading="lazy" /><p class="status">{ar?"خمسة أيام · نُفذ":"Five days · delivered"}</p><h3>{ar?"دبلوم الإعلام الرقمي والذكاء الاصطناعي":"AI Media Diploma"}</h3><p>{ar?"برنامج عربي مع أنشطة ومنصة مرافقة عامة. تبقى أعمال المتعلمين وتقييماتهم خاصة.":"Arabic programme with activities and a public companion platform. Learner work and assessment remain private."}</p><a class="text-link" href={withBase(`${lang==="ar"?"/ar":""}/work/ai-media-diploma/`)}>{ar?"دراسة الحالة":"Case study"} ↗</a></article><article class="editorial-panel"><img src={withBase("/media/selected/birzeit-ai-ad-lab.webp")} alt={ar?"الصفحة العامة لمختبر بيرزيت":"Public Birzeit advertising lab homepage"} width="900" height="600" loading="lazy" /><p class="status">{ar?"أربعة أيام · ٢٤ ساعة":"Four days · 24 hours"}</p><h3>{ar?"مختبر الإعلان بالذكاء الاصطناعي — بيرزيت":"Birzeit AI Advertising Lab"}</h3><p>{ar?"وثّق تقرير الإنجاز نحو ٢٠ مشاركاً. لا تُعرض هنا بياناتهم أو أعمالهم.":"The completion report records about 20 participants. Their identities and work are not shown here."}</p><a class="text-link" href={withBase(`${lang==="ar"?"/ar":""}/work/birzeit-ai-ad-lab/`)}>{ar?"دراسة الحالة":"Case study"} ↗</a></article></div></section>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"ثلاثة أشكال":"Three formats"}</p><div><h2>{ar?"من جلسة مركزة إلى نظام تعلم كامل":"From a focused session to a full learning system"}</h2></div></header><div class="workshop-grid">{formats.map(item=><article class="editorial-panel"><h2>{item.h}</h2><p>{item.d}</p><p class="status">{item.duration}</p></article>)}</div></section>
<section class="evidence-band"><div class="chapter workshop-evidence"><div class="workshop-evidence__copy"><p class="eyebrow">{ar?"أمثلة عامة":"Public examples"}</p><h2>{ar?"مختبر التحقق ومختبر بيرزيت للطلاقة":"AI Verification Lab and Birzeit AI Fluency Lab"}</h2><p>{ar?"أمثلة على التدريب الذي يتحول إلى بيئة ويب ومواد ومراجعة قابلة للمعاينة. لا تُذكر أرقام حضور غير موثقة.":"Examples of training becoming a web environment, materials, and an inspectable review flow. No unsupported attendance figures are claimed."}</p><div class="button-row"><a class="button button--light" href={withBase(`${lang==="ar"?"/ar":""}/work/ai-verification-lab/`)}>{ar?"افتح دراسة الحالة":"Open the case study"}</a><a class="button button--light" href="https://birzeit-ai-fluency-lab-2026.pages.dev" target="_blank" rel="noopener noreferrer">{ar?"افتح مختبر بيرزيت":"Open Birzeit lab"} ↗</a></div></div><div class="workshop-proof-media"><figure><img src={withBase("/media/workshops/ai-verification-lab-hero.jpg")} alt={ar?"واجهة مختبر التحقق":"AI Verification Lab interface"} width="900" height="600" loading="lazy" /></figure><figure><img src={withBase("/media/workshops/birzeit-ai-fluency-home.jpg")} alt={ar?"واجهة مختبر بيرزيت للطلاقة":"Birzeit AI Fluency Lab interface"} width="900" height="600" loading="lazy" /></figure></div></div></section>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"دليل التنفيذ":"Delivery evidence"}</p><div><h2>{ar?"أمثلة عامة ومحددة، دون أرقام مختلقة":"Named public-safe examples, without invented metrics"}</h2><p>{ar?"يظهر كل مثال الجمهور ونوع العمل وحالة التنفيذ فقط.":"Each example states the audience, the work delivered, and its status only."}</p></div></header><div class="delivery-proof-grid">{proofItems.map(item=><article class="editorial-panel"><p class="status">{item.status}</p><h3>{item.title}</h3><p><strong>{item.audience}</strong></p><p>{item.proof}</p></article>)}</div></section>
<section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"ما يحتاجه التنفيذ":"Delivery details"}</p><div><h2>{ar?"لغة وجمهور وإعداد واضح":"Clear language, audience, and setup"}</h2></div></header><div class="ways-grid"><article class="editorial-panel"><h3>{ar?"الجمهور":"Audiences"}</h3><p>{ar?"جامعات ومؤسسات وفرق إعلام ومعلمون ومجتمعات وفرق مهنية.":"Universities, organizations, media teams, educators, communities, and professional teams."}</p></article><article class="editorial-panel"><h3>{ar?"اللغات والحضور":"Language and delivery"}</h3><p>{ar?"العربية أو الإنجليزية أو صيغة ثنائية. حضورياً عند الإمكان أو عن بُعد.":"Arabic, English, or bilingual. In person where possible or remote."}</p></article><article class="editorial-panel"><h3>{ar?"التخصيص":"Customization"}</h3><p>{ar?"يبدأ بموجز عن الجمهور والهدف والوقت والأجهزة والمصادر المتاحة.":"Starts with a brief covering audience, outcome, time, devices, and available sources."}</p></article></div><p><a class="button" href={withBase(`${routeFor("contact",lang)}?type=workshop`)}>{ar?"ابدأ موجز ورشة":"Start a workshop brief"}</a></p></section>
</BaseLayout>
