---
import BaseLayout from "../layouts/BaseLayout.astro";import {projects} from "../data/portfolio";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";const offers=ar?[
{title:"كلّف قصة أو عالماً بصرياً",for:"للحملات والروايات الثقافية والموسيقى والقصص التعليمية والأفلام القصيرة.",problems:"فكرة قوية بلا لغة بصرية متماسكة، أو مواد مولدة تحتاج إخراجاً واستمرارية.",sprint:"مرحلة أولى تحدد الفكرة الحاكمة والعالم البصري وخطة الإنتاج ونموذجاً قابلاً للمراجعة.",proof:"literary-reimaginings",cta:"ناقش مشروع قصة",type:"story"},
{title:"احجز ورشة أو مختبر تعلم",for:"للمؤسسات والجامعات وفرق الإعلام والمعلمين والمجتمعات.",problems:"معرفة بالأدوات دون ممارسة أو معايير مراجعة أو مواد تبقى بعد الجلسة.",sprint:"تصميم جمهور وأهداف وتدفق جلسة وأنشطة ومواد مصدر ونموذج مختبر أو حزمة متابعة.",proof:"ai-verification-lab",cta:"خطط لورشة",type:"workshop"},
{title:"شكّل منتجاً أو نظاماً إبداعياً",for:"للأرشيفات والمنصات الثنائية والمنتجات التعليمية والنماذج العملية.",problems:"مواد كثيرة بلا بنية استخدام، أو فكرة تحتاج سطحاً عاماً واختباراً سريعاً.",sprint:"خريطة محتوى ومسار مستخدم ونموذج أولي ونظام بيانات وخطة واضحة للمرحلة التالية.",proof:"museum-of-echoes",cta:"ابدأ مرحلة منتج",type:"product"}
]:[
{title:"Commission a story or visual world",for:"For campaigns, cultural narratives, music, educational stories, and short films.",problems:"A strong idea without a coherent visual language, or generated material that needs direction and continuity.",sprint:"A focused first phase defining the governing idea, visual world, production plan, and a reviewable sample.",proof:"literary-reimaginings",cta:"Discuss a story project",type:"story"},
{title:"Book a workshop or learning lab",for:"For organizations, universities, media teams, educators, and communities.",problems:"Tool awareness without practice, review standards, or materials people can keep using.",sprint:"Audience and outcome design, session flow, activities, sources, and a lab or follow-up pack.",proof:"ai-verification-lab",cta:"Plan a workshop",type:"workshop"},
{title:"Shape a product or creative system",for:"For archives, bilingual experiences, learning products, and practical prototypes.",problems:"Strong material without a usable structure, or an idea that needs a public surface and an early test.",sprint:"Content map, user path, working prototype, structured data, and a clear next-phase decision.",proof:"museum-of-echoes",cta:"Start a product sprint",type:"product"}
];
---
<BaseLayout title={ar?"طرق التعاون | تامر منصور":"Ways to Work | Tamer Mansour"} description={ar?"ثلاثة مسارات واضحة للتعاون في القصة والورشات والمنتجات الإبداعية.":"Three clear engagement paths for stories, workshops, and creative products."} path={routeFor("ways",lang)} lang={lang} dir={ar?"rtl":"ltr"}>
<header class="page-hero chapter"><p class="eyebrow">{ar?"طرق التعاون":"Ways to work"}</p><h1>{ar?"ابدأ بالمشكلة، لا بقائمة خدمات.":"Start with the problem, not a service menu."}</h1><p>{ar?"الاستشارة جزء من كل مسار: تحديد ما يستحق البناء، وما يكفي لاختباره أولاً، وما يجب أن يبقى خارج النطاق.":"Consulting is built into every path: deciding what deserves to be made, what should be tested first, and what should stay out of scope."}</p></header>
<section class="section chapter ways-grid">{offers.map(offer=>{const proof=projects.find(p=>p.slug===offer.proof)!;return <article class="editorial-panel"><h2>{offer.title}</h2><h3>{ar?"لمن؟":"Who it serves"}</h3><p>{offer.for}</p><h3>{ar?"المشكلة المعتادة":"Typical problem"}</h3><p>{offer.problems}</p><h3>{ar?"ما تنتجه المرحلة الأولى":"What the first sprint produces"}</h3><p>{offer.sprint}</p><p><a class="text-link" href={withBase(`${lang==="ar"?"/ar":""}/work/${proof.slug}/`)}>{ar?"الدليل":"Proof"}: {proof.title[lang]} ↗</a></p><a class="button" href={withBase(`${routeFor("contact",lang)}?type=${offer.type}`)}>{offer.cta}</a></article>})}</section>
<section class="inquiry-decision"><div class="chapter inquiry-decision__inner"><h2>{ar?"بعد الموجز":"After the brief"}</h2><p>{ar?"أراجع الهدف والجمهور والتوقيت، ثم أقترح أصغر خطوة مفيدة: جلسة توجيه، معالجة، تصميم ورشة، أو نموذج أولي.":"I review the goal, audience, and timing, then suggest the smallest useful next step: a direction session, treatment, workshop design, or prototype."}</p></div></section>
</BaseLayout>

