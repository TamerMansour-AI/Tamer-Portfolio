---
import BaseLayout from "../layouts/BaseLayout.astro";import {projects} from "../data/portfolio";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";const offers=ar?[
{title:"كلّف قصة أو عالماً بصرياً",for:"للحملات والروايات الثقافية والموسيقى والقصص التعليمية والأفلام القصيرة.",fit:"مناسب حين تكون الرسالة واضحة لكن العالم البصري أو تسلسل القصة أو استمرارية المشاهد لم تُحسم بعد.",problems:"فكرة قوية بلا لغة بصرية متماسكة، أو مواد مولدة تحتاج إخراجاً واستمرارية.",sprint:"مرحلة أولى تحدد الفكرة الحاكمة والعالم البصري وخطة الإنتاج ونموذجاً قابلاً للمراجعة.",outputs:"معالجة إبداعية، اتجاه بصري، خريطة مشاهد، نموذج إثبات، ونقاط مراجعة للإنتاج.",proof:"literary-reimaginings",proof2:"anbiya-visuals",cta:"ناقش مشروع قصة",type:"story"},
{title:"احجز ورشة أو مختبر تعلم",for:"للمؤسسات والجامعات وفرق الإعلام والمعلمين والمجتمعات.",fit:"مناسب حين يحتاج الفريق إلى ممارسة قابلة للتكرار ومواد يحتفظ بها، لا عرض أدوات لمرة واحدة.",problems:"معرفة بالأدوات دون ممارسة أو معايير مراجعة أو مواد تبقى بعد الجلسة.",sprint:"تصميم جمهور وأهداف وتدفق جلسة وأنشطة ومواد مصدر ونموذج مختبر أو حزمة متابعة.",outputs:"خطة تيسير، أنشطة عملية، حزمة مصادر، مسارات عمل، ودليل متابعة أو مختبر ويب.",proof:"ai-verification-lab",proof2:"knowledge-products",cta:"خطط لورشة",type:"workshop"},
{title:"شكّل منتجاً أو مكاناً رقمياً",for:"للأرشيفات والمنصات الثنائية والمنتجات التعليمية.",fit:"حين تحتاج مواد قيّمة بنية واضحة ومسار استخدام ونسخة أولى قابلة للاختبار.",problems:"مواد كثيرة بلا بنية استخدام أو تجربة عامة.",sprint:"خريطة محتوى ومسار مستخدم ونموذج أولي وخطة للمرحلة التالية.",outputs:"بنية محتوى ونموذج مستجيب وقواعد تحرير.",proof:"museum-of-echoes",proof2:"nakba-atlas",cta:"ابدأ مرحلة منتج",type:"product"},
{title:"صمّم نظام عمل بمراجعة بشرية",for:"للفرق التي تريد تنظيم البحث أو الإنتاج أو خدمة العملاء بمساعدة الوكلاء.",fit:"حين تكون المهمة متكررة ومصادرها معروفة والقرارات المؤثرة تتطلب مراجعة.",problems:"خطوات متفرقة يصعب تتبعها أو التحقق من مخرجاتها.",sprint:"رسم المسار، تحديد الحدود، وبناء تجربة صغيرة قابلة للفحص.",outputs:"خريطة تدفق ونموذج محدود وقواعد مراجعة بشرية.",proof:"signal-workflow",proof2:"agent-foundry",cta:"ناقش نظام عمل",type:"system"}
]:[
{title:"Commission a story or visual world",for:"For campaigns, cultural narratives, music, educational stories, and short films.",fit:"A good fit when the message is clear but the visual world, story sequence, or scene continuity is not yet resolved.",problems:"A strong idea without a coherent visual language, or generated material that needs direction and continuity.",sprint:"A focused first phase defining the governing idea, visual world, production plan, and a reviewable sample.",outputs:"Creative treatment, visual direction, scene map, proof sample, and production review points.",proof:"literary-reimaginings",proof2:"anbiya-visuals",cta:"Discuss a story project",type:"story"},
{title:"Book a workshop or learning lab",for:"For organizations, universities, media teams, educators, and communities.",fit:"A good fit when a team needs repeatable practice and materials it can keep—not a one-off tool demonstration.",problems:"Tool awareness without practice, review standards, or materials people can keep using.",sprint:"Audience and outcome design, session flow, activities, sources, and a lab or follow-up pack.",outputs:"Facilitation plan, practical activities, source pack, workflows, and a follow-up guide or web lab.",proof:"ai-verification-lab",proof2:"knowledge-products",cta:"Plan a workshop",type:"workshop"},
{title:"Shape a product or digital place",for:"For archives, bilingual experiences and learning products.",fit:"When valuable material needs structure, a usable path and a testable first version.",problems:"Strong material without a usable public experience.",sprint:"Content map, user path, prototype and next-phase plan.",outputs:"Content architecture, responsive prototype and editorial rules.",proof:"museum-of-echoes",proof2:"nakba-atlas",cta:"Start a product sprint",type:"product"},
{title:"Design a human-reviewed system",for:"For teams organizing research, production or service workflows with agent assistance.",fit:"When a repeatable task has known sources and consequential decisions require review.",problems:"Scattered steps and outputs that are hard to inspect.",sprint:"Map the workflow, set boundaries and build a small inspectable pilot.",outputs:"Workflow map, limited prototype and human review rules.",proof:"signal-workflow",proof2:"agent-foundry",cta:"Discuss a system",type:"system"}
];
---
<BaseLayout title={ar?"طرق التعاون | تامر منصور":"Ways to Work | Tamer Mansour"} description={ar?"ثلاثة مسارات واضحة للتعاون في القصة والورشات والمنتجات الإبداعية.":"Three clear engagement paths for stories, workshops, and creative products."} path={routeFor("ways",lang)} lang={lang} dir={ar?"rtl":"ltr"}>
<header class="page-hero chapter"><p class="eyebrow">{ar?"طرق التعاون":"Ways to work"}</p><h1>{ar?"ابدأ بالمشكلة، لا بقائمة خدمات.":"Start with the problem, not a service menu."}</h1><p>{ar?"الاستشارة جزء من كل مسار: تحديد ما يستحق البناء، وما يكفي لاختباره أولاً، وما يجب أن يبقى خارج النطاق.":"Consulting is built into every path: deciding what deserves to be made, what should be tested first, and what should stay out of scope."}</p></header>
<section class="section chapter ways-grid">{offers.map(offer=>{const proof=projects.find(p=>p.slug===offer.proof)!;const proof2=projects.find(p=>p.slug===offer.proof2)!;return <article class="editorial-panel"><h2>{offer.title}</h2><h3>{ar?"لمن؟":"Who it serves"}</h3><p>{offer.for}</p><h3>{ar?"متى يكون مناسباً؟":"When it fits"}</h3><p>{offer.fit}</p><h3>{ar?"المشكلة المعتادة":"Typical problem"}</h3><p>{offer.problems}</p><h3>{ar?"ما تنتجه المرحلة الأولى":"What the first sprint produces"}</h3><p>{offer.sprint}</p><h3>{ar?"ما الذي تستلمه؟":"What you leave with"}</h3><p>{offer.outputs}</p><div class="proof-links"><a class="text-link" href={withBase(`${lang==="ar"?"/ar":""}/work/${proof.slug}/`)}>{proof.title[lang]} ↗</a><a class="text-link" href={withBase(`${lang==="ar"?"/ar":""}/work/${proof2.slug}/`)}>{proof2.title[lang]} ↗</a></div><a class="button" href={withBase(`${routeFor("contact",lang)}?type=${offer.type}`)}>{offer.cta}</a></article>})}</section>
<section class="inquiry-decision"><div class="chapter inquiry-decision__inner"><h2>{ar?"بعد الموجز":"After the brief"}</h2><p>{ar?"أراجع الهدف والجمهور والتوقيت، ثم أقترح أصغر خطوة مفيدة: جلسة توجيه، معالجة، تصميم ورشة، أو نموذج أولي.":"I review the goal, audience, and timing, then suggest the smallest useful next step: a direction session, treatment, workshop design, or prototype."}</p></div></section>
</BaseLayout>
