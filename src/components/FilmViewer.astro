---
import type { Locale } from "../data/locale";
import { withBase } from "../utils/withBase";
const { lang = "en", videoId, poster, title } = Astro.props as {lang?:Locale;videoId:string;poster:string;title:string};
const ar = lang === "ar";
---
<div class="film-viewer" data-film-viewer data-video-id={videoId}>
  <button type="button" class="film-viewer__poster" data-film-open aria-label={ar ? `شاهد الفيلم: ${title}` : `Watch the film: ${title}`}>
    <img src={withBase(poster)} alt="" width="1280" height="720" loading="lazy" />
    <span class="film-viewer__play" aria-hidden="true">▶</span>
    <span class="film-viewer__label">{ar ? "شاهد الفيلم" : "Watch the film"}</span>
  </button>
  <dialog class="film-viewer__dialog" data-film-dialog aria-label={ar ? `مشغل فيلم ${title}` : `${title} film player`}>
    <div class="film-viewer__dialog-head"><strong>{title}</strong><button type="button" data-film-close aria-label={ar ? "أغلق المشغل" : "Close player"}>×</button></div>
    <iframe title={title} data-film-frame allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <p>{ar ? "يبدأ تشغيل الفيديو عند ضغط زر التشغيل في المشغل. يمكن فتحه بملء الشاشة." : "Press play in the player to begin. Fullscreen is available."} <a href={`https://youtu.be/${videoId}`} target="_blank" rel="noopener noreferrer">{ar ? "افتحه على YouTube إذا لم يعمل المشغل" : "Open on YouTube if the player does not load"} ↗</a></p>
  </dialog>
</div>
<script>
  for (const viewer of document.querySelectorAll<HTMLElement>('[data-film-viewer]')) {
    const dialog=viewer.querySelector<HTMLDialogElement>('[data-film-dialog]')!;
    const frame=viewer.querySelector<HTMLIFrameElement>('[data-film-frame]')!;
    const open=viewer.querySelector<HTMLButtonElement>('[data-film-open]')!;
    open.addEventListener('click',()=>{
      for(const other of document.querySelectorAll<HTMLDialogElement>('[data-film-dialog][open]')) other.close();
      frame.src=`https://www.youtube-nocookie.com/embed/${viewer.dataset.videoId}?rel=0`;
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-film-close]')?.focus();
    });
    dialog.querySelector('[data-film-close]')?.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
    dialog.addEventListener('close',()=>{frame.removeAttribute('src');open.focus({preventScroll:true})});
  }
</script>
