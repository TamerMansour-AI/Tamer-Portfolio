---
import type { Locale } from "../data/locale";
import { routeFor } from "../data/locale";
import { withBase } from "../utils/withBase";

const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
const work = withBase(routeFor("work", lang));
const contact = withBase(routeFor("contact", lang));
const cases = [
  { id: "canaan", title: ar ? "هنا كنعان" : "Here Was Canaan", type: ar ? "فيلم منشور · تخيّل فني" : "Released film · artistic interpretation", image: "/media/optimized/here-was-canaan-cover.jpg", href: `${ar ? "/ar" : ""}/work/here-was-canaan/` },
  { id: "diploma", title: ar ? "الدبلوم" : "AI Media Diploma", type: ar ? "منصة تعلّم رقمية" : "Digital learning platform", image: "/media/selected/ai-media-diploma.webp", href: `${ar ? "/ar" : ""}/work/ai-media-diploma/` },
  { id: "signal", title: "Signal", type: ar ? "نظام عمل شخصي · تصور توضيحي" : "Personal workflow · illustrative diagram", image: "", href: `${ar ? "/ar" : ""}/work/signal-workflow/` }
];
---
<section class="spatial-hero" data-spatial-hero data-active="canaan" aria-labelledby="spatial-hero-title">
  <img class="spatial-hero__environment" src={withBase("/media/spatial/environment-v1.webp")} alt="" width="1488" height="1057" fetchpriority="high" />
  <div class="spatial-hero__shade" aria-hidden="true"></div>
  <p class="spatial-hero__side-note">{ar ? <>تحويل الأفكار<br />إلى عوالم تُفهم.</> : <>Turning ideas<br />into worlds to explore.</>}</p>
  <div class="spatial-hero__worlds" aria-label={ar ? "ثلاثة عوالم مختارة" : "Three selected worlds"}>
    <a class="spatial-world spatial-world--canaan" href={withBase(cases[0].href)} data-world="canaan" aria-label={`${cases[0].title} — ${ar ? "دراسة الحالة" : "case study"}`}>
      <img src={withBase(cases[0].image)} alt={ar ? "لقطة أصلية من فيلم هنا كانت كنعان: شخصان يفحصان قماشاً في السوق" : "Original Here Was Canaan film frame: two people examine a textile in a market"} width="1280" height="720" fetchpriority="high" />
      <span class="spatial-world__caption"><span class="spatial-world__play" aria-hidden="true">▶</span><span><strong>{cases[0].title}</strong><small>{cases[0].type}</small></span></span>
    </a>
    <a class="spatial-world spatial-world--diploma" href={withBase(cases[1].href)} data-world="diploma" aria-label={`${cases[1].title} — ${ar ? "دراسة الحالة" : "case study"}`}>
      <img src={withBase(cases[1].image)} alt={ar ? "لقطة من الصفحة العامة المرافقة لدبلوم الإعلام والذكاء الاصطناعي" : "Screenshot of the public AI Media Diploma companion site"} width="1024" height="640" />
      <span class="spatial-world__caption"><span><strong>{cases[1].title}</strong><small>{cases[1].type}</small></span></span>
    </a>
    <a class="spatial-world spatial-world--signal" href={withBase(cases[2].href)} data-world="signal" aria-label={`${cases[2].title} — ${ar ? "دراسة الحالة" : "case study"}`}>
      <span class="spatial-signal__name">Signal</span>
      <span class="spatial-signal__subtitle">{ar ? "نظام عمل شخصي" : "Personal workflow"}</span>
      <span class="spatial-signal__steps" aria-hidden="true"><span>▤<small>{ar ? "هدف" : "Goal"}</small></span><b>→</b><span>⚙<small>{ar ? "إنتاج" : "Create"}</small></span><b>→</b><span>✓<small>{ar ? "مراجعة" : "Review"}</small></span></span>
      <span class="spatial-signal__note">{ar ? "تصور توضيحي" : "Illustrative diagram"}</span>
    </a>
  </div>
  <img class="spatial-hero__glass" src={withBase("/media/spatial/glass-planes-v1.webp")} alt="" width="1487" height="1058" aria-hidden="true" />
  <div class="spatial-hero__intro">
    <p class="spatial-hero__eyebrow">{ar ? "تامر منصور / استوديو إبداعي وتقني" : "Tamer Mansour / Creative technology studio"}</p>
    <h1 id="spatial-hero-title">{ar ? <>خيال يُرى.<br /><em>وتقنية تُجرَّب.</em></> : <>Ideas made visible.<br /><em>Technology to try.</em></>}</h1>
    <p class="spatial-hero__description">{ar ? "قصص بصرية، وتجارب تعلّم، وأنظمة بمساعدة الذكاء الاصطناعي." : "Visual stories, learning experiences, and systems shaped with AI."}</p>
    <div class="spatial-hero__actions"><a class="spatial-hero__primary" href={work}>{ar ? "استكشف أعمالي" : "Explore my work"}<span aria-hidden="true">{ar ? "←" : "→"}</span></a><a class="spatial-hero__contact" href={contact}>{ar ? "لنتحدث" : "Let's talk"}</a></div>
  </div>
  <div class="spatial-hero__selector" role="group" aria-label={ar ? "اختر عالماً" : "Choose a world"}>
    <button class="spatial-hero__arrow" type="button" data-spatial-prev aria-label={ar ? "العالم السابق" : "Previous world"}>←</button>
    {cases.map((item, index) => <button class="spatial-hero__choice" type="button" data-spatial-select={item.id} data-spatial-title={item.title} data-spatial-type={item.type} data-spatial-target={withBase(item.href)} aria-pressed={index === 0 ? "true" : "false"}><span class="spatial-hero__thumb">{item.image ? <img src={withBase(item.image)} alt="" width="80" height="68" loading="lazy" /> : <span class="spatial-hero__thumb-signal" aria-hidden="true">◎</span>}</span><span><strong>{item.title}</strong><small>{item.type}</small></span><span class="spatial-hero__dot" aria-hidden="true"></span></button>)}
    <button class="spatial-hero__arrow" type="button" data-spatial-next aria-label={ar ? "العالم التالي" : "Next world"}>→</button>
  </div>
  <a class="spatial-hero__all" href={work}>{ar ? "عرض كل الأعمال" : "View all work"} <span aria-hidden="true">⊞</span></a>
  <div class="spatial-hero__current"><span data-spatial-current-caption aria-live="polite">{cases[0].title} · {cases[0].type}</span><a data-spatial-current-link href={withBase(cases[0].href)}>{ar ? "استكشف المشروع" : "Explore this project"} <span aria-hidden="true">↗</span></a></div>
  <p class="spatial-hero__footnote">{ar ? "فن × تعليم × ذكاء اصطناعي" : "Art × Learning × AI"}</p>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('[data-spatial-hero]');
  if (hero) {
    const ids = ['canaan', 'diploma', 'signal'];
    const choices = [...hero.querySelectorAll<HTMLButtonElement>('[data-spatial-select]')];
    const select = (id: string) => {
      if (!ids.includes(id)) return;
      hero.dataset.active = id;
      for (const choice of choices) choice.setAttribute('aria-pressed', String(choice.dataset.spatialSelect === id));
      const selected = choices.find(choice => choice.dataset.spatialSelect === id);
      const caption = hero.querySelector<HTMLElement>('[data-spatial-current-caption]');
      const link = hero.querySelector<HTMLAnchorElement>('[data-spatial-current-link]');
      if (selected && caption) caption.textContent = `${selected.dataset.spatialTitle} · ${selected.dataset.spatialType}`;
      if (selected && link && selected.dataset.spatialTarget) link.href = selected.dataset.spatialTarget;
    };
    for (const choice of choices) choice.addEventListener('click', () => select(choice.dataset.spatialSelect || 'canaan'));
    const move = (delta: number) => {
      const current = ids.indexOf(hero.dataset.active || 'canaan');
      const next = (current + delta + ids.length) % ids.length;
      select(ids[next]);
      const choice = choices[next];
      choice?.focus({ preventScroll: true });
      const selector = hero.querySelector<HTMLElement>('.spatial-hero__selector');
      if (choice && selector) selector.scrollTo({ left: choice.offsetLeft - selector.clientWidth / 2 + choice.clientWidth / 2, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    hero.querySelector('[data-spatial-prev]')?.addEventListener('click', () => move(-1));
    hero.querySelector('[data-spatial-next]')?.addEventListener('click', () => move(1));
    hero.querySelector('.spatial-hero__selector')?.addEventListener('keydown', event => {
      if (event instanceof KeyboardEvent && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
        event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
  }
</script>
