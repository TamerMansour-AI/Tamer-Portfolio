---
import type { Locale } from "../data/locale";
import { routeFor } from "../data/locale";
import { heroWorks } from "../data/heroWorks";
import { withBase } from "../utils/withBase";
const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
const href = (url:string) => url.startsWith("/") ? withBase(url) : url;
const first = heroWorks[0];
---
<section class="living-hero" data-living-hero aria-labelledby="living-hero-title">
  <div class="living-hero__copy">
    <p class="living-hero__eyebrow">{ar ? "تامر منصور / استوديو إبداعي وتقني" : "Tamer Mansour / Creative technology studio"}</p>
    <h1 id="living-hero-title">{ar ? <>خيال يُرى.<br /><em>وتقنية تُجرَّب.</em></> : <>Ideas made visible.<br /><em>Technology to try.</em></>}</h1>
    <p>{ar ? "قصص بصرية، وتجارب تعلّم، ومنتجات رقمية وأنظمة عمل صُممت لتُشاهد وتُستخدم." : "Visual stories, learning experiences, digital products and working systems made to watch and use."}</p>
    <div class="living-hero__intro-actions"><a class="studio-button studio-button--blue" href={withBase(routeFor("work",lang))}>{ar ? "استكشف الأعمال" : "Explore the work"} ↗</a><a href={withBase(routeFor("contact",lang))}>{ar ? "لنتحدث" : "Let's talk"}</a></div>
    <div class="living-hero__selected" aria-live="polite"><span>{ar ? "المشروع المختار" : "Selected work"}</span><h2 data-living-title>{first.title[lang]}</h2><p data-living-type>{first.type[lang]}</p><div><a class="living-hero__work-link" data-living-work href={href(first.href[lang])} target="_blank" rel="noopener noreferrer">{first.action[lang]} ↗</a><a data-living-case href={withBase(`${ar?"/ar":""}/work/${first.caseSlug}/`)}>{ar ? "خلف المشروع" : "Behind the work"} ↗</a></div></div>
  </div>
  <div class="living-hero__media">
    <img class="living-hero__environment" src={withBase("/media/spatial/environment-v1.webp")} alt="" width="1488" height="1057" fetchpriority="high" />
    <div class="living-hero__stage" data-living-stage aria-label={ar ? "معرض المشاريع المختارة" : "Selected work gallery"}>
      {heroWorks.map((item,index) => <a class:list={["living-hero__card",{"living-hero__card--portrait":item.portrait}]} data-living-card={index} data-position={index===0?"active":index===1?"next":index===heroWorks.length-1?"prev":"away"} data-case-href={item.caseSlug ? withBase(`${ar?"/ar":""}/work/${item.caseSlug}/`) : ""} href={href(item.href[lang])} target={item.href[lang].startsWith("/")?undefined:"_blank"} rel={item.href[lang].startsWith("/")?undefined:"noopener noreferrer"} aria-label={`${item.action[lang]}: ${item.title[lang]}`} aria-hidden={index===0?undefined:"true"} tabindex={index===0?0:-1}>
        <img src={withBase(item.image)} alt={item.title[lang]} width="1200" height="800" loading={index===0?"eager":"lazy"} decoding="async" />
        <span class="living-hero__card-caption"><strong>{item.title[lang]}</strong><small>{item.type[lang]}</small></span>
      </a>)}
    </div>
    <img class="living-hero__glass" src={withBase("/media/spatial/glass-planes-v1.webp")} alt="" width="1487" height="1058" aria-hidden="true" />
    <p class="living-hero__media-label">{ar ? "من الفيلم إلى المنصة إلى الفن" : "From film to platform to art"}</p>
  </div>
  <div class="living-hero__controls" role="group" aria-label={ar ? "اختر مشروعًا" : "Choose a project"}>
    <button type="button" data-living-prev aria-label={ar ? "المشروع السابق" : "Previous project"}>←</button>
    <div class="living-hero__rail">{heroWorks.map((item,index) => <button type="button" data-living-select={index} aria-pressed={index===0?"true":"false"}><span>{String(index+1).padStart(2,"0")}</span><strong>{item.title[lang]}</strong></button>)}</div>
    <button type="button" data-living-next aria-label={ar ? "المشروع التالي" : "Next project"}>→</button>
    <span class="living-hero__count" data-living-count>01 / {String(heroWorks.length).padStart(2,"0")}</span>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('[data-living-hero]');
  if (hero) {
    const cards = [...hero.querySelectorAll<HTMLAnchorElement>('[data-living-card]')];
    const choices = [...hero.querySelectorAll<HTMLButtonElement>('[data-living-select]')];
    const data = cards.map(card => ({title:card.querySelector('strong')?.textContent||'',type:card.querySelector('small')?.textContent||'',action:card.getAttribute('aria-label')?.split(': ')[0]||''}));
    let active = 0;
    const render = (index:number) => {
      active = (index + cards.length) % cards.length;
      cards.forEach((card,i) => {
        const offset=(i-active+cards.length)%cards.length;
        const position=offset===0?'active':offset===1?'next':offset===cards.length-1?'prev':'away';
        card.dataset.position=position;
        card.tabIndex=position==='active'?0:-1;
        if(position==='active') card.removeAttribute('aria-hidden'); else card.setAttribute('aria-hidden','true');
      });
      choices.forEach((choice,i)=>choice.setAttribute('aria-pressed',String(i===active)));
      hero.querySelector<HTMLElement>('[data-living-title]')!.textContent=data[active].title;
      hero.querySelector<HTMLElement>('[data-living-type]')!.textContent=data[active].type;
      const link=hero.querySelector<HTMLAnchorElement>('[data-living-work]')!;
      link.href=cards[active].href;link.textContent=data[active].action+' ↗';
      if(link.href.startsWith(location.origin)){link.removeAttribute('target');link.removeAttribute('rel')}else{link.target='_blank';link.rel='noopener noreferrer'}
      const caseLink=hero.querySelector<HTMLAnchorElement>('[data-living-case]')!;
      if(cards[active].dataset.caseHref){caseLink.hidden=false;caseLink.href=cards[active].dataset.caseHref!}else caseLink.hidden=true;
      hero.querySelector<HTMLElement>('[data-living-count]')!.textContent=`${String(active+1).padStart(2,'0')} / ${String(cards.length).padStart(2,'0')}`;
      choices[active].scrollIntoView({block:'nearest',inline:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
    };
    choices.forEach((choice,i)=>choice.addEventListener('click',()=>render(i)));
    hero.querySelector('[data-living-prev]')?.addEventListener('click',()=>render(active-1));
    hero.querySelector('[data-living-next]')?.addEventListener('click',()=>render(active+1));
    hero.querySelector('.living-hero__controls')?.addEventListener('keydown',event=>{
      if(!(event instanceof KeyboardEvent))return;
      if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();render(active+(event.key===(document.documentElement.lang==='ar'?'ArrowLeft':'ArrowRight')?1:-1));choices[active].focus({preventScroll:true})}
    });
    const stage=hero.querySelector<HTMLElement>('[data-living-stage]')!;
    let start:{x:number,y:number}|null=null;
    stage.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse')start={x:event.clientX,y:event.clientY}});
    stage.addEventListener('pointerup',event=>{if(!start)return;const dx=event.clientX-start.x,dy=event.clientY-start.y;if(Math.abs(dx)>48&&Math.abs(dx)>Math.abs(dy)*1.3){event.preventDefault();render(active+(dx<0?(document.documentElement.lang==='ar'?-1:1):(document.documentElement.lang==='ar'?1:-1)))}start=null});
  }
</script>
