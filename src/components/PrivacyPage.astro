---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeFor, type Locale } from "../data/locale";

const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
---

<BaseLayout
  title={ar ? "الخصوصية والتحليلات | تامر منصور" : "Privacy & analytics | Tamer Mansour"}
  description={ar ? "كيف يستخدم هذا الموقع التحليلات ويحترم اختيارك وبياناتك." : "How this portfolio uses analytics while respecting your choice and personal data."}
  path={routeFor("privacy", lang)}
  lang={lang}
  dir={ar ? "rtl" : "ltr"}
>
  <article class="reading-page privacy-page">
    <p class="eyebrow">{ar ? "الخصوصية" : "Privacy"}</p>
    <h1>{ar ? "قياس بسيط، باختيارك." : "Simple measurement, your choice."}</h1>
    <p class="lede">{ar ? "يستخدم هذا الموقع Google Analytics 4 فقط بعد موافقتك، لفهم الزيارات والصفحات المفيدة وتحسين المحفظة." : "This site uses Google Analytics 4 only after you accept, to understand visits, useful pages, and how the portfolio can improve."}</p>

    <h2>{ar ? "ما الذي يتم قياسه؟" : "What is measured?"}</h2>
    <p>{ar ? "قد تُقاس مشاهدة الصفحات، ونوع الجهاز، والموقع الجغرافي التقريبي، وفتح دراسة حالة أو فيلم، والنقر على وسيلة تواصل، وتجهيز موجز في تطبيق البريد. لا يعني تجهيز الموجز وصوله إلينا." : "Measurements may include page views, device type, approximate location, opening a case or film, clicking a contact method, and preparing an inquiry in an email app. Preparing an inquiry does not mean it was received."}</p>

    <h2>{ar ? "ما الذي لا أرسله إلى Google؟" : "What is not sent to Google?"}</h2>
    <p>{ar ? "لا ترسل أحداث الموقع اسمك أو بريدك الإلكتروني أو رقم هاتفك أو اسم المؤسسة أو الجمهور أو الميزانية أو نص الرسالة. نموذج التواصل يفتح تطبيق البريد لديك ولا يخزن البيانات على خادم الموقع." : "Site events do not send your name, email address, phone number, organization, audience, budget, or message text. The contact form opens your email app and does not store the form data on the site."}</p>

    <h2>{ar ? "الموافقة والتحكم" : "Consent and control"}</h2>
    <p>{ar ? "لن يتصل الموقع بخدمة Google Analytics قبل أن تختار السماح. يمكنك الرفض أو تغيير اختيارك في أي وقت عبر زر إعدادات التحليلات في تذييل كل صفحة." : "The site does not contact Google Analytics until you choose to allow it. You can decline or change your choice at any time using Analytics settings in the footer of every page."}</p>

    <h2>{ar ? "المزيد من المعلومات" : "More information"}</h2>
    <p>{ar ? "تشرح Google كيفية حماية بيانات Analytics واستخدامها في وثائق الخصوصية الخاصة بها." : "Google explains how Analytics data is safeguarded and used in its privacy documentation."} <a href="https://support.google.com/analytics/answer/6004245" target="_blank" rel="noopener noreferrer">Google Analytics privacy information ↗</a></p>

    <p class="privacy-page__updated">{ar ? "آخر تحديث: ٢٣ سبتمبر ٢٠٢٦" : "Last updated: September 23, 2026"}</p>
  </article>
</BaseLayout>
