---
import BaseLayout from "../layouts/BaseLayout.astro";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";
---
<BaseLayout title={ar?"عن تامر منصور | مخرج إبداعي فلسطيني":"About Tamer Mansour | Palestinian Creative Director"} description={ar?"عن ممارسة تامر منصور بين السرد والتعليم والأنظمة الإبداعية من رام الله.":"About Tamer Mansour’s practice across storytelling, education, and creative systems from Ramallah."} path={routeFor("about",lang)} lang={lang} dir={ar?"rtl":"ltr"} image="/media/optimized/profile.webp">
<header class="page-hero chapter"><p class="eyebrow">{ar?"عن الممارسة":"About the practice"}</p><h1>{ar?"القصة أولاً. الأداة في مكانها الصحيح.":"Story first. Tools in their proper place."}</h1><p>{ar?"أنا تامر منصور، مخرج إبداعي فلسطيني ومعلّم وصانع من رام الله. أعمل حيث يلتقي السرد بالتعلم وبناء الأنظمة.":"I’m Tamer Mansour, a Palestinian creative director, educator, and builder based in Ramallah. I work where storytelling meets learning and systems."}</p></header>
<section class="section chapter about-fragment"><img src={withBase("/media/optimized/profile.webp")} alt={ar?"صورة تامر منصور":"Portrait of Tamer Mansour"} width="800" height="800"/><div><p class="eyebrow">{ar?"منهج العمل":"Working method"}</p><h2>{ar?"المعنى، ثم البنية، ثم الإنتاج.":"Meaning, then structure, then production."}</h2><p class="lede">{ar?"أبدأ بالسؤال والجمهور والتوتر العاطفي أو التعليمي. بعد ذلك أبني بنية يمكن مراجعتها، وأختار أدوات الذكاء الاصطناعي أو الويب أو الفيديو التي تخدمها. الحكم البشري ليس خطوة أخيرة؛ إنه حاضر في كل قرار.":"I begin with the question, audience, and emotional or learning tension. Then I build a reviewable structure and choose the AI, web, or video tools that serve it. Human judgment is not a final checkpoint; it shapes every decision."}</p></div></section>
<section class="section chapter"><div class="ways-grid"><article class="editorial-panel"><h2>{ar?"متجذر في المكان":"Grounded in place"}</h2><p>{ar?"رام الله والسياق الفلسطيني واللغة والمصدر ليست طبقة بصرية؛ إنها جزء من القرارات التي تحدد ما يُعرض وكيف.":"Ramallah, Palestinian context, language, and provenance are not a visual layer. They inform what is shown and how it is edited."}</p></article><article class="editorial-panel"><h2>{ar?"عقلية تعليم":"A teaching mindset"}</h2><p>{ar?"لا يكفي تسليم الناتج. أبني أنشطة ومصادر ونقاط مراجعة تجعل المعرفة قابلة للاستخدام بعد التسليم.":"Output alone is not enough. I build activities, sources, and review points that keep the knowledge useful after handoff."}</p></article><article class="editorial-panel"><h2>{ar?"أنظمة تصمد":"Systems that hold up"}</h2><p>{ar?"أحوّل القرارات الناجحة إلى هياكل قابلة للتكرار دون جعل العمل آلياً أو بلا شخصية.":"I turn successful decisions into repeatable structures without making the work mechanical or anonymous."}</p></article></div><p><a class="button" href={withBase(routeFor("contact",lang))}>{ar?"ابدأ تعاوناً":"Start a collaboration"}</a></p></section>
</BaseLayout>

