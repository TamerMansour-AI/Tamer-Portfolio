---
import type { Project } from "../data/portfolio";
import { laneLabels } from "../data/portfolio";
import type { Locale } from "../data/locale";
import { withBase } from "../utils/withBase";
const { project, lang = "en", featured = false } = Astro.props as { project: Project; lang?: Locale; featured?: boolean };
const href = withBase((lang === "ar" ? "/ar" : "") + "/work/" + project.slug + "/");
const ar = lang === "ar";
---
<article class:list={["project-card", { "project-card--featured": featured }]}>
<a class:list={["project-card__media", "project-card__media--" + project.mediaFit, "project-card__media--" + project.mediaShape]} href={href} aria-label={(ar ? "افتح " : "Open ") + project.title[lang]}><img src={withBase(project.media)} alt={project.mediaAlt[lang]} width="1200" height="800" loading="lazy" decoding="async" /></a>
<div class="project-card__body"><p class="eyebrow">{laneLabels[project.lane][lang]}</p><h3><a href={href}>{project.title[lang]}</a></h3><p>{project.summary[lang]}</p><p class="project-card__status">{project.status[lang]}</p>{project.mediaKind === "illustration" && <small>{ar ? "صورة توضيحية · ليست لقطة من المشروع" : "Illustration · not a project screenshot"}</small>}<a class="text-link" href={href}>{ar ? "اقرأ دراسة الحالة" : "Read the case study"} ↗</a></div>
</article>
