---
import type { Project } from "../data/portfolio";
import { laneLabels } from "../data/portfolio";
import type { Locale } from "../data/locale";
import { withBase } from "../utils/withBase";
import NativeFilm from './NativeFilm.astro';
import { watchableMedia } from '../data/watchableMedia';
const { project, lang = "en", featured = false } = Astro.props as { project: Project; lang?: Locale; featured?: boolean };
const href = withBase((lang === "ar" ? "/ar" : "") + "/work/" + project.slug + "/");
const ar = lang === "ar";
const film = watchableMedia[project.slug];
const directUrl = project.slug === "literary-reimaginings" ? href + "#watch-the-works" : project.slug === "here-was-canaan" && !ar ? "https://youtu.be/ASw6DRV1OHg" : project.publicUrl;
const external = directUrl?.startsWith("https://");
const directLabel = project.slug === "here-was-canaan" ? (ar ? "شاهد الفيلم" : "Watch the film") : project.slug === "athar" ? (ar ? "شاهد الريل" : "Watch the reel") : project.slug === "caresignal-systems" ? (ar ? "جرّب العرض" : "Try the demo") : project.lane === "systems" ? (ar ? "افتح العرض" : "Open the demo") : (ar ? "استكشف المشروع" : "Explore the project");
---
<article class:list={["project-card", { "project-card--featured": featured }]}>
{film ? <NativeFilm compact src={film.src} poster={film.poster} captions={film.captions} title={project.title[lang]} /> : <a class:list={["project-card__media", "project-card__media--" + project.mediaFit, "project-card__media--" + project.mediaShape]} href={directUrl || href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} aria-label={directLabel + ": " + project.title[lang]}><img src={withBase(project.media)} alt={project.mediaAlt[lang]} width="1200" height="800" loading="lazy" decoding="async" /></a>}
<div class="project-card__body"><p class="eyebrow">{laneLabels[project.lane][lang]}</p><h3><a href={href}>{project.title[lang]}</a></h3><p>{project.summary[lang]}</p><p class="project-card__status">{project.status[lang]}</p>{project.mediaKind === "illustration" && <small>{ar ? "صورة توضيحية · ليست لقطة من المشروع" : "Illustration · not a project screenshot"}</small>}<div class="project-card__actions">{directUrl && <a class="text-link" href={directUrl} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{directLabel} ↗</a>}<a class="text-link" href={href}>{ar ? "خلف المشروع" : "Behind the work"} ↗</a></div></div>
</article>
