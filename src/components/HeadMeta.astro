---
import {siteData} from "../data/site";import {localizedPath} from "../data/locale";
const {title,description,path="/",lang="en",image,pageType="WebPage",schema:extra}=Astro.props;const site=Astro.site?.toString()??"https://tamermansour-ai.github.io";const base=import.meta.env.BASE_URL;const urlFor=(value:string)=>new URL(`${base}${value.replace(/^\//,"")}`,site).toString();const canonical=urlFor(path);const en=urlFor(localizedPath(path,"en"));const ar=urlFor(localizedPath(path,"ar"));const og=image?urlFor(image):urlFor("/media/optimized/hero-poster.webp");const graph={"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":`${urlFor("/")}#website`,url:urlFor("/"),name:siteData.name,inLanguage:["en","ar"]},{"@type":"Person","@id":`${urlFor("/")}#person`,name:siteData.name,jobTitle:"Palestinian AI creative director, educator, and builder",url:urlFor("/"),image:og,email:`mailto:${siteData.email}`,address:{"@type":"PostalAddress",addressLocality:"Ramallah",addressCountry:"PS"},knowsLanguage:["en","ar"],sameAs:Object.values(siteData.social)},{"@type":pageType,"@id":`${canonical}#page`,url:canonical,name:title,description,inLanguage:lang,isPartOf:{"@id":`${urlFor("/")}#website`}},...(Array.isArray(extra)?extra:extra?[extra]:[])]};
---
<title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow"/><meta name="theme-color" content="#152019"/><meta name="author" content={siteData.name}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={en}/><link rel="alternate" hreflang="ar" href={ar}/><link rel="alternate" hreflang="x-default" href={en}/><meta property="og:type" content={pageType==="Article"?"article":"website"}/><meta property="og:site_name" content={siteData.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={og}/><meta property="og:image:alt" content={`${siteData.name} — Palestinian AI creative direction`}/><meta property="og:locale" content={lang==="ar"?"ar_PS":"en_US"}/><meta property="og:locale:alternate" content={lang==="ar"?"en_US":"ar_PS"}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={og}/><script type="application/ld+json" set:html={JSON.stringify(graph)}/>
