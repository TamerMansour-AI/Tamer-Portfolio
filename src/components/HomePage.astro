---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/portfolio";
import { routeFor, type Locale } from "../data/locale";
import { withBase } from "../utils/withBase";
import "../styles/editorial-proof.css";

const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
const featuredSlugs = ["here-was-canaan", "ai-verification-lab", "museum-of-echoes", "literary-reimaginings"];
const selected = featuredSlugs.map((slug) => projects.find((item) => item.slug === slug)).filter((item) => item !== undefined);
const t = ar ? {
  title: "تامر منصور | أفلام وتعلّم وتجارب رقمية وأنظمة عمل",
  description: "أعمال تامر منصور في السرد البصري والتدريب والتجارب الرقمية وأنظمة العمل المدعومة بالذكاء الاصطناعي.",
  eyebrow: "تامر منصور · رام الله / يعمل عالمياً",
  headline: "أصنع قصصاً تُرى، ومعرفة تُستخدم.",
  intro: "أجمع السرد البصري والتعلّم والتقنية في أفلام وتجارب وأنظمة عملية. ابدأ بعمل منشور، ثم اكتشف ما يمكن أن نصنعه معاً.",
  work: "استكشف الأعمال", contact: "تواصل معي", film: "هنا كنعان", filmType: "فيلم منشور · تخيّل فني", watch: "شاهد الفيلم", filmNote: "من الفيلم المنشور «هنا كنعان»؛ تصور فني مستند إلى بحث.",
  practices: "مجالات العمل", practicesIntro: "أربع ممارسات تتقاطع في المشاريع؛ تظهر هنا الأعمال الجاهزة للعرض العام.",
  lanes: [
    { label: "السرد البصري", note: "أفلام، موسيقى، وتفسير بصري للقصص.", href: "/ar/work/#stories" },
    { label: "التعلّم والورشات", note: "تدريب عملي ومواد تبقى بعد الجلسة.", href: "/ar/workshops/" },
    { label: "التجارب الرقمية", note: "أرشيفات ومنصات ثنائية اللغة.", href: "/ar/work/#products" },
    { label: "الوكلاء والأنظمة", note: "مسارات عمل مدعومة بالوكلاء وتحت مراجعة بشرية.", href: null }
  ],
  selected: "أعمال مختارة", selectedIntro: "نماذج من أعمال منشورة وقابلة للفحص. سيُضاف المزيد بعد التحقق من المواد وحدود النشر.", open: "افتح دراسة الحالة", all: "كل الأعمال والأرشيف",
  approach: "من الفكرة إلى شيء يمكن رؤيته أو استخدامه", approachCopy: "في كل مشروع أبدأ بالسياق والجمهور، ثم أحدد الشكل المناسب: فيلم، ورشة، موقع، أو نظام عمل. القرار الإبداعي والمراجعة البشرية جزء من النتيجة.", ways: "طرق التعاون", about: "عن تامر",
  cta: "لديك قصة أو معرفة تحتاج شكلاً واضحاً؟", ctaCopy: "أرسل الهدف والجمهور بإيجاز، أو تواصل مباشرة بالبريد وواتساب.", start: "ابدأ الحوار", identity: "شاهد فيلم التعريف"
} : {
  title: "Tamer Mansour | Film, Learning, Digital Experiences & Systems",
  description: "Selected work by Tamer Mansour across visual storytelling, training, digital experiences, and human-reviewed AI systems.",
  eyebrow: "Tamer Mansour · Ramallah / working globally",
  headline: "I make stories visible and knowledge usable.",
  intro: "I bring visual storytelling, learning, and technology together in films, experiences, and practical systems. Start with published work, then explore what we could make together.",
  work: "Explore the work", contact: "Get in touch", film: "Here Was Canaan", filmType: "Released film · artistic interpretation", watch: "Watch the film", filmNote: "From the published film Here Was Canaan; a research-informed artistic interpretation.",
  practices: "The practice", practicesIntro: "Four connected disciplines; the work ready for public viewing appears here.",
  lanes: [
    { label: "Visual storytelling", note: "Films, music, and visual interpretations of stories.", href: "/work/#stories" },
    { label: "Learning & workshops", note: "Practical teaching and materials that outlast the session.", href: "/workshops/" },
    { label: "Digital experiences", note: "Bilingual archives and public platforms.", href: "/work/#products" },
    { label: "Agents & systems", note: "Agent-assisted workflows with human review.", href: null }
  ],
  selected: "Selected work", selectedIntro: "Published and inspectable examples. More will follow once media and public boundaries are confirmed.", open: "Open case study", all: "All work & archive",
  approach: "From an idea to something people can see or use", approachCopy: "Each project starts with context and audience, then finds its form: film, workshop, website, or working system. Creative direction and human review remain part of the result.", ways: "Ways to work", about: "About Tamer",
  cta: "Have a story or body of knowledge that needs form?", ctaCopy: "Share the goal and audience briefly, or reach me directly by email or WhatsApp.", start: "Start a conversation", identity: "Watch the identity film"
};
---
<BaseLayout title={t.title} description={t.description} path={routeFor("home", lang)} lang={lang} dir={ar ? "rtl" : "ltr"} image="/media/optimized/here-was-canaan-cover.jpg" pageType="ProfilePage">
  <section class="editorial-hero">
    <div class="chapter editorial-hero__inner">
      <div class="editorial-hero__copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.headline}</h1>
        <p class="editorial-hero__intro">{t.intro}</p>
        <div class="hero-actions"><a class="button" href={withBase(routeFor("work", lang))}>{t.work}</a><a class="button button--ghost" href={withBase(routeFor("contact", lang))}>{t.contact}</a></div>
      </div>
      <figure class="editorial-hero__feature">
        <a href={withBase(`${ar ? "/ar" : ""}/work/here-was-canaan/`)} aria-label={`${t.open}: ${t.film}`}><img src={withBase("/media/optimized/here-was-canaan-cover.jpg")} alt={ar ? "مشهد مرسوم لسوق كنعاني من فيلم هنا كنعان" : "Illustrated Canaan market scene from Here Was Canaan"} width="1280" height="720" fetchpriority="high" /></a>
        <figcaption><span><strong>{t.film}</strong><small>{t.filmType}</small></span><a href={ar ? "https://youtu.be/jV699yrESYw" : "https://youtu.be/ASw6DRV1OHg"} target="_blank" rel="noopener noreferrer">{t.watch} ↗</a></figcaption>
        <p class="editorial-hero__note">{t.filmNote}</p>
      </figure>
    </div>
  </section>

  <section class="editorial-practices chapter" aria-labelledby="practice-title">
    <div class="editorial-section-heading"><p class="eyebrow">{t.practices}</p><div><h2 id="practice-title">{t.practices}</h2><p>{t.practicesIntro}</p></div></div>
    <div class="editorial-practices__grid">{t.lanes.map((lane) => lane.href ? <a href={withBase(lane.href)}><span class="editorial-practices__arrow" aria-hidden="true">↗</span><h3>{lane.label}</h3><p>{lane.note}</p></a> : <div><span class="editorial-practices__arrow" aria-hidden="true">—</span><h3>{lane.label}</h3><p>{lane.note}</p></div>)}</div>
  </section>

  <section class="editorial-selected chapter" aria-labelledby="selected-title">
    <div class="editorial-section-heading"><p class="eyebrow">{t.selected}</p><div><h2 id="selected-title">{t.selected}</h2><p>{t.selectedIntro}</p></div></div>
    <div class="editorial-work-grid">{selected.map((project) => <article class="editorial-work"><a href={withBase(`${ar ? "/ar" : ""}/work/${project.slug}/`)} class="editorial-work__image"><img src={withBase(project.media)} alt={project.mediaAlt[lang]} width="1200" height="800" loading="lazy" decoding="async" /></a><div class="editorial-work__meta"><span>{project.status[lang]}</span><span>{project.date[lang]}</span></div><h3><a href={withBase(`${ar ? "/ar" : ""}/work/${project.slug}/`)}>{project.title[lang]}</a></h3><p>{project.summary[lang]}</p><a class="text-link" href={withBase(`${ar ? "/ar" : ""}/work/${project.slug}/`)}>{t.open} ↗</a></article>)}</div>
    <a class="button button--ghost" href={withBase(routeFor("work", lang))}>{t.all}</a>
  </section>

  <section class="editorial-about"><div class="chapter editorial-about__inner"><img src={withBase("/media/optimized/profile.webp")} alt={ar ? "صورة تامر منصور" : "Portrait of Tamer Mansour"} width="800" height="800" loading="lazy" /><div><p class="eyebrow">{t.about}</p><h2>{t.approach}</h2><p>{t.approachCopy}</p><div class="button-row"><a class="button" href={withBase(routeFor("ways", lang))}>{t.ways}</a><a class="button button--ghost" href={withBase(routeFor("about", lang))}>{t.about}</a><button class="text-link editorial-about__play" type="button" data-identity-open aria-controls="identity-film">{t.identity} ↗</button></div><video id="identity-film" hidden controls playsinline preload="none" poster={withBase("/media/optimized/hero-poster.webp")} aria-label={t.identity} data-src={withBase("/media/optimized/identity-film.mp4")}></video></div></div></section>
  <section class="editorial-contact chapter"><p class="eyebrow">{t.contact}</p><h2>{t.cta}</h2><p>{t.ctaCopy}</p><a class="button" href={withBase(routeFor("contact", lang))}>{t.start}</a></section>
</BaseLayout>
<script>
const play = document.querySelector('[data-identity-open]');
const video = document.querySelector('#identity-film');
if (play instanceof HTMLButtonElement && video instanceof HTMLVideoElement) {
  play.addEventListener('click', () => {
    const src = video.dataset.src;
    if (src && !video.src) video.src = src;
    video.hidden = false;
    play.hidden = true;
    video.focus();
  });
}
</script>
