---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpatialHomeHero from "./SpatialHomeHero.astro";
import { projects } from "../data/portfolio";
import { routeFor, type Locale } from "../data/locale";
import { withBase } from "../utils/withBase";

const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
const bySlug = (slug: string) => projects.find((project) => project.slug === slug)!;
const film = bySlug("here-was-canaan");
const learning = bySlug("ai-verification-lab");
const digital = bySlug("museum-of-echoes");
const literary = bySlug("literary-reimaginings");
const additionalFeatures = ["ai-media-diploma", "athar", "nakba-atlas", "signal-workflow", "birzeit-ai-ad-lab"].map(bySlug);
const caseUrl = (slug: string) => withBase(`${ar ? "/ar" : ""}/work/${slug}/`);
const t = ar ? {
  title: "تامر منصور | استوديو للسرد والتعلّم والتجارب الرقمية",
  description: "أفلام وتجارب تعلّم ومنصات رقمية وأنظمة عمل مدعومة بالذكاء الاصطناعي من تامر منصور في رام الله.",
  eyebrow: "تامر منصور / ممارسة إبداعية وتقنية",
  headline1: "فكرة واحدة.", headline2: "أشكال متعددة.",
  intro: "أحوّل الأفكار إلى أفلام وتجارب تعلّم وأماكن رقمية وأنظمة عمل. تبدأ كل تجربة بسؤال واضح، وتنتهي بشيء يمكن رؤيته أو استخدامه.",
  explore: "استكشف الأعمال", contact: "تواصل معي", scroll: "اكتشف الممارسة", stageNote: "أعمال حقيقية من السرد والتعلّم والمنتجات الرقمية",
  filmLabel: "فيلم منشور · تخيّل فني", learningLabel: "مختبر تعلّم عام", digitalLabel: "منصة استماع عامة",
  workEyebrow: "أعمال مختارة", workTitle: "أشكال مختلفة. عمل يمكن فحصه.", workIntro: "أفلام، أدوات تعلّم وتجارب رقمية وأنظمة عمل؛ لكل مشروع حالة تنفيذ وحدود عرض واضحة.",
  filmOpen: "دراسة الحالة", filmWatch: "شاهد الفيلم", open: "افتح المشروع", more: "تصفح كل الأعمال", posterLabel: "سلسلة بصرية منشورة",
  formsEyebrow: "من الفكرة إلى المخرج", formsTitle: "الشكل يتبع الغاية.", formsIntro: "أختار الشكل الذي يخدم القصة والجمهور: شاشة، جلسة، مكان رقمي، أو سير عمل. هذه صور رمزية مصنوعة خصيصًا للمحفظة؛ العمل الموثق يظهر في المشاريع المرتبطة.",
  seed: "البداية: سؤال أو فكرة", forms: [
    { title: "سرد بصري", note: "فيلم وصورة وصوت", object: "story", href: "/ar/work/#stories" },
    { title: "تعلّم عملي", note: "ورشة ومواد قابلة للاستخدام", object: "learning", href: "/ar/workshops/" },
    { title: "مكان رقمي", note: "أرشيف أو منصة ثنائية اللغة", object: "digital", href: "/ar/work/#products" },
    { title: "نظام عمل", note: "وكلاء ضمن مراجعة بشرية", object: "agents", href: "/ar/systems/" }
  ],
  signalTag: "مثال توضيحي · نظام Signal الشخصي", signalTitle: "الوكيل يساعد. القرار يُراجع.", signalIntro: "هذا تبسيط لمسار عمل شخصي، وليس واجهة منتج منشور أو خدمة تعمل وحدها طوال الوقت.",
  signalSteps: [{ title: "المدخل", note: "هدف مشروع ومصادره" }, { title: "المعالجة", note: "بحث وصياغة بمساعدة وكيل" }, { title: "المراجعة", note: "قرار وتدقيق بشري" }, { title: "المخرج", note: "مادة قابلة للاستخدام" }],
  endTitle: "لديك مشروع يحتاج شكلاً جديدًا؟", endCopy: "صف الهدف والجمهور بإيجاز، ونحدد نقطة بدء عملية.", ways: "طرق التعاون", start: "ابدأ الحوار", identity: "شاهد فيلم التعريف"
} : {
  title: "Tamer Mansour | Creative Technology Studio",
  description: "Films, learning experiences, digital places and human-reviewed AI workflows by Tamer Mansour in Ramallah.",
  eyebrow: "Tamer Mansour / creative technology practice",
  headline1: "One idea.", headline2: "Many forms.",
  intro: "I shape ideas into films, learning experiences, digital places and working systems. Each begins with a clear question and ends with something people can see or use.",
  explore: "Explore the work", contact: "Get in touch", scroll: "Explore the practice", stageNote: "Real work across storytelling, learning and digital products",
  filmLabel: "Released film · artistic interpretation", learningLabel: "Public learning lab", digitalLabel: "Public listening platform",
  workEyebrow: "Selected work", workTitle: "Different forms. Work you can inspect.", workIntro: "Films, learning tools, digital places and working systems, each with a clear status and public boundary.",
  filmOpen: "Case study", filmWatch: "Watch the film", open: "Open the project", more: "Browse all work", posterLabel: "Published visual series",
  formsEyebrow: "From idea to output", formsTitle: "Choose the form that fits.", formsIntro: "The form follows the story and audience: screen, session, digital place or workflow. These custom objects are symbolic; the linked projects carry the evidence.",
  seed: "It starts with a question", forms: [
    { title: "Visual story", note: "Film, image and sound", object: "story", href: "/work/#stories" },
    { title: "Practical learning", note: "Workshop and usable materials", object: "learning", href: "/workshops/" },
    { title: "Digital place", note: "Archive or bilingual platform", object: "digital", href: "/work/#products" },
    { title: "Working system", note: "Agents with human review", object: "agents", href: "/systems/" }
  ],
  signalTag: "Illustrative example · personal Signal workflow", signalTitle: "The agent helps. A person decides.", signalIntro: "A simplified personal workflow, not a screenshot of a released product or an unattended service.",
  signalSteps: [{ title: "Input", note: "Project goal and sources" }, { title: "Process", note: "Agent-assisted research and draft" }, { title: "Review", note: "Human judgment and checks" }, { title: "Output", note: "Usable material" }],
  endTitle: "Have a project that needs a new form?", endCopy: "Share the goal and audience briefly, and we can identify a practical first step.", ways: "Ways to work", start: "Start a conversation", identity: "Watch the identity film"
};
---
<BaseLayout title={t.title} description={t.description} path={routeFor("home", lang)} lang={lang} dir={ar ? "rtl" : "ltr"} image="/media/optimized/here-was-canaan-cover.jpg" pageType="ProfilePage" variant="spatial">
  <SpatialHomeHero lang={lang} />

  <section id="selected-work" class="studio-work chapter" aria-labelledby="studio-work-title">
    <header class="studio-section-head" data-reveal><p class="studio-kicker">{t.workEyebrow}</p><h2 id="studio-work-title">{t.workTitle}</h2><p>{t.workIntro}</p></header>
    <div class="studio-work__grid">
      <article class="studio-work__feature" data-reveal><a class="studio-work__feature-media" href={caseUrl(film.slug)}><img src={withBase(film.media)} alt={film.mediaAlt[lang]} width="1280" height="720" loading="lazy" decoding="async" /></a><div class="studio-work__feature-info"><div><p class="studio-kicker">{t.filmLabel}</p><h3><a href={caseUrl(film.slug)}>{film.title[lang]}</a></h3><p>{film.summary[lang]}</p></div><div class="studio-work__feature-links"><a href={caseUrl(film.slug)}>{t.filmOpen} ↗</a><a data-analytics="watch" href={ar ? "https://youtu.be/jV699yrESYw" : "https://youtu.be/ASw6DRV1OHg"} target="_blank" rel="noopener noreferrer">{t.filmWatch} ↗</a></div></div></article>
      <div class="studio-work__more-grid">{additionalFeatures.map((item) => <article class="studio-work__small" data-reveal><a href={caseUrl(item.slug)}><img src={withBase(item.media)} alt={item.mediaAlt[lang]} width="900" height="600" loading="lazy" decoding="async" /></a><p class="studio-kicker">{item.status[lang]}</p><h3><a href={caseUrl(item.slug)}>{item.title[lang]}</a></h3><p>{item.summary[lang]}</p>{item.mediaKind === "illustration" && <small>{ar ? "صورة توضيحية" : "Illustrative image"}</small>}</article>)}</div>
    </div>
    <a class="studio-button studio-button--outline studio-work__more" href={withBase(routeFor("work", lang))}>{t.more}<span aria-hidden="true">↗</span></a>
  </section>

  <section class="studio-forms" aria-labelledby="studio-forms-title"><div class="chapter">
    <header class="studio-section-head studio-section-head--dark" data-reveal><p class="studio-kicker">{t.formsEyebrow}</p><h2 id="studio-forms-title">{t.formsTitle}</h2><p>{t.formsIntro}</p></header>
    <div class="studio-forms__seed" data-reveal><span aria-hidden="true"></span>{t.seed}</div>
    <div class="studio-forms__grid" data-forms>{t.forms.map((form) => <article class="studio-form"><img src={withBase(`/media/studio/${form.object}.webp`)} alt="" width="1050" height="875" loading="lazy" decoding="async" /><h3>{form.title}</h3><p>{form.note}</p>{form.href && <a href={withBase(form.href)} aria-label={`${t.open}: ${form.title}`}>{t.open} ↗</a>}</article>)}</div>
    <div class="studio-signal" data-reveal><div><p class="studio-kicker">{t.signalTag}</p><h3>{t.signalTitle}</h3><p>{t.signalIntro}</p></div><ol>{t.signalSteps.map((step) => <li><strong>{step.title}</strong><span>{step.note}</span></li>)}</ol></div>
  </div></section>

  <section class="studio-end chapter" aria-labelledby="studio-end-title"><p class="studio-kicker">{t.contact}</p><h2 id="studio-end-title">{t.endTitle}</h2><p>{t.endCopy}</p><div class="studio-actions"><a class="studio-button studio-button--blue" href={withBase(routeFor("contact", lang))}>{t.start}<span aria-hidden="true">↗</span></a><a class="studio-button studio-button--outline" href={withBase(routeFor("ways", lang))}>{t.ways}</a><button class="studio-button studio-button--outline" type="button" data-identity-open aria-controls="identity-film">{t.identity} ▶</button></div><video id="identity-film" hidden controls playsinline preload="none" poster={withBase("/media/optimized/hero-poster.webp")} aria-label={t.identity} data-src={withBase("/media/optimized/identity-film.mp4")}></video></section>
</BaseLayout>
<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const identityButton = document.querySelector('[data-identity-open]');
const identityFilm = document.querySelector('#identity-film');
if (identityButton instanceof HTMLButtonElement && identityFilm instanceof HTMLVideoElement) {
  identityButton.addEventListener('click', () => {
    const src = identityFilm.dataset.src;
    if (src && !identityFilm.src) identityFilm.src = src;
    identityFilm.hidden = false;
    identityButton.hidden = true;
    identityFilm.focus();
  });
}
if (!reduceMotion && 'IntersectionObserver' in window) {
  const revealObserver = new IntersectionObserver((entries, observer) => {
    for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
  }, { threshold: 0.12, rootMargin: '0px 0px 40px 0px' });
  document.querySelectorAll('[data-reveal], [data-forms]').forEach((item) => revealObserver.observe(item));
  document.body.classList.add('studio-motion-ready');
}
</script>
