---
import BaseLayout from "../layouts/BaseLayout.astro";import ProjectCard from "./ProjectCard.astro";import {featuredProjects} from "../data/portfolio";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";
const t=ar?{
title:"تامر منصور | مخرج إبداعي فلسطيني للذكاء الاصطناعي ومعلّم وصانع منتجات",description:"تامر منصور مخرج إبداعي فلسطيني ومعلّم وصانع يحوّل القصص المتجذرة والمعرفة المعقدة إلى تجارب بصرية وأنظمة تعلم ومنتجات عامة.",eyebrow:"مخرج إبداعي فلسطيني / معلّم / صانع",headline:"من قصص متجذرة إلى تجارب عامة.",intro:"أحوّل القصص ذات السياق الثقافي والمعرفة المعقدة إلى أفلام وتجارب بصرية وورشات عملية ومنتجات رقمية ثنائية اللغة. يبدأ العمل من المعنى، ثم تُختار الأدوات التي تخدمه.",work:"شاهد الأعمال المختارة",brief:"ابدأ موجزاً",play:"شاهد فيلم الهوية",cred:["من رام الله، تعاون عن بُعد","العربية والإنجليزية","قصة، تعلم، منتج"],lanesTitle:"ممارسة واحدة، ثلاث طرق للدخول",lanesIntro:"القصة هي المصدر. التعلم يمنحها بنية. والمنتج يجعلها قابلة للاستخدام العام.",lanes:[{n:"القصص والإعلام",d:"أفلام قصصية وعوالم بصرية وتكييفات أدبية وإصدارات موسيقية تحمل توجهاً واضحاً."},{n:"التعلم والورشات",d:"تجارب تعلم عملية تتحول إلى أنشطة ومصادر ومسارات وأدوات تبقى بعد الجلسة."},{n:"المنتجات والمنصات",d:"أرشيفات ومواقع ومنتجات تعليمية وأنظمة إبداعية تجعل الفكرة قابلة للاستخدام."}],flag:"ثلاثة أعمال تقود المحفظة",flagIntro:"كل حالة تربط الدور والجمهور والقرار الإبداعي بالدليل العام المتاح.",ways:"طرق واضحة للتعاون",offers:[{h:"كلّف قصة أو عالماً بصرياً",p:"للحملات والروايات الثقافية والموسيقى والقصص التعليمية والأفلام القصيرة.",q:"ناقش مشروع قصة",type:"story"},{h:"احجز ورشة أو مختبر تعلم",p:"للمؤسسات والجامعات وفرق الإعلام والمعلمين والمجتمعات.",q:"خطط لورشة",type:"workshop"},{h:"شكّل منتجاً أو نظاماً إبداعياً",p:"للأرشيفات والمنصات الثنائية والمنتجات التعليمية والنماذج العملية.",q:"ابدأ مرحلة منتج",type:"product"}],evidence:"الدليل ليس صفحة منفصلة. إنه جزء من كل دراسة حالة: دور واضح، مادة عامة، وحدود صريحة لما يبقى خاصاً.",aboutTitle:"فلسطيني من رام الله، يعمل بين السرد والتعليم والأنظمة.",aboutCopy:"أتعامل مع الذكاء الاصطناعي كجزء من حرفة أوسع: بحث وحكم بشري وإخراج وبنية قابلة للتكرار. الهوية لا تظهر كزخرفة؛ تظهر في اللغة والمصدر والمكان وطريقة تقديم العمل.",aboutLink:"اقرأ عن الممارسة",final:"لديك فكرة تحتاج شكلاً واضحاً؟",finalCopy:"اختر المسار الأقرب وأرسل الهدف والجمهور والتوقيت. ستتلقى خطوة أولى مركزة، مع بقاء البريد وواتساب متاحين دائماً.",start:"ابدأ الحوار"}:{
title:"Tamer Mansour | Palestinian AI Creative Director, Educator, and Builder",description:"Tamer Mansour is a Palestinian AI creative director, educator, and builder turning culturally grounded stories and complex knowledge into visual experiences, learning systems, and public products.",eyebrow:"Palestinian creative director / educator / builder",headline:"From grounded stories to public experiences.",intro:"I turn culturally grounded stories and complex knowledge into films, visual experiences, practical workshops, and bilingual digital products. The work starts with meaning; the tools follow the idea.",work:"View selected work",brief:"Start a brief",play:"Play the identity film",cred:["Ramallah — working remotely","Arabic + English","Story, learning, product"],lanesTitle:"One practice. Three ways in.",lanesIntro:"Story is the source. Learning gives it structure. Products make it usable in public.",lanes:[{n:"Stories & Media",d:"Story films, visual worlds, literary interpretations, and music releases shaped with a clear point of view."},{n:"Learning & Workshops",d:"Practical learning experiences that become activities, sources, workflows, and tools people keep using."},{n:"Products & Platforms",d:"Archives, bilingual sites, educational products, and creative systems that give an idea public life."}],flag:"Three projects lead the portfolio",flagIntro:"Each case connects role, audience, creative decisions, and public evidence without overstating results.",ways:"Clear ways to work together",offers:[{h:"Commission a story or visual world",p:"For campaigns, cultural narratives, music, educational stories, and short films.",q:"Discuss a story project",type:"story"},{h:"Book a workshop or learning lab",p:"For organizations, universities, media teams, educators, and communities.",q:"Plan a workshop",type:"workshop"},{h:"Shape a product or creative system",p:"For archives, bilingual experiences, learning products, and practical prototypes.",q:"Start a product sprint",type:"product"}],evidence:"Proof is no longer a separate burden. It lives inside each case: a precise role, inspectable public material, and an explicit boundary around what remains private.",aboutTitle:"Palestinian, based in Ramallah, working across story, teaching, and systems.",aboutCopy:"I treat AI as one part of a wider craft: research, human judgment, direction, and repeatable structure. Identity is not decoration here. It appears through language, provenance, place, and how the work is edited for public life.",aboutLink:"Read about the practice",final:"Have an idea that needs form?",finalCopy:"Choose the closest path and share the goal, audience, and timing. I will suggest a focused first step. Email and WhatsApp always remain available.",start:"Start the conversation"};
---
<BaseLayout title={t.title} description={t.description} path={routeFor("home",lang)} lang={lang} dir={ar?"rtl":"ltr"} image="/media/optimized/hero-poster.webp" pageType="ProfilePage">
  <section class="hero chapter"><div class="hero__grid"><div class="hero__copy"><p class="eyebrow">{t.eyebrow}</p><h1 class="display">{t.headline}</h1><p class="lede">{t.intro}</p><div class="hero-actions"><a class="button" href={withBase(routeFor("work",lang))}>{t.work}</a><a class="button button--ghost" href={withBase(routeFor("contact",lang))}>{t.brief}</a></div></div><div class="hero__media"><img src={withBase("/media/optimized/profile.webp")} alt={ar?"صورة تامر منصور في استوديو إبداعي":"Tamer Mansour in a creative studio"} width="800" height="800" fetchpriority="high"/><button class="media-play" type="button" aria-controls="identity-film">{t.play}</button><video id="identity-film" hidden controls playsinline preload="none" poster={withBase("/media/optimized/hero-poster.webp")} aria-label={t.play} data-src={withBase("/media/optimized/identity-film.mp4")}></video></div></div></section>
  <section class="credibility"><div class="chapter credibility__inner">{t.cred.map((item,index)=><div><span class="lane__mark">0{index+1}</span><p><strong>{item}</strong></p></div>)}</div></section>
  <section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"الممارسة":"The practice"}</p><div><h2>{t.lanesTitle}</h2><p>{t.lanesIntro}</p></div></header><div class="lane-grid">{t.lanes.map((lane,index)=><article class="lane"><span class="lane__mark">0{index+1}</span><h3>{lane.n}</h3><p>{lane.d}</p></article>)}</div></section>
  <section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"الأعمال الرئيسية":"Flagship work"}</p><div><h2>{t.flag}</h2><p>{t.flagIntro}</p></div></header><div class="project-stack">{featuredProjects.map(project=><ProjectCard project={project} lang={lang} featured />)}</div><p style="margin-top:2rem"><a class="text-link" href={withBase(routeFor("work",lang))}>{ar?"عرض كل الأعمال المختارة":"View all selected work"} ↗</a></p></section>
  <section class="section chapter"><header class="section-heading"><p class="eyebrow">{ar?"التعاون":"Engagements"}</p><div><h2>{t.ways}</h2></div></header><div class="offers">{t.offers.map(offer=><article class="offer"><h3>{offer.h}</h3><p>{offer.p}</p><a class="text-link" href={withBase(`${routeFor("contact",lang)}?type=${offer.type}`)}>{offer.q} ↗</a></article>)}</div><p><a class="text-link" href={withBase(routeFor("ways",lang))}>{ar?"استكشف طرق التعاون":"Explore ways to work"} ↗</a></p></section>
  <section class="evidence-band"><div class="chapter evidence-band__inner"><p class="eyebrow">{ar?"دليل بمسؤولية":"Evidence with boundaries"}</p><blockquote>{t.evidence}</blockquote></div></section>
  <section class="section chapter about-fragment"><img src={withBase("/media/optimized/profile.webp")} alt={ar?"صورة تامر منصور":"Portrait of Tamer Mansour"} width="800" height="800" loading="lazy"/><div><p class="eyebrow">{ar?"عن تامر":"About Tamer"}</p><h2>{t.aboutTitle}</h2><p class="lede">{t.aboutCopy}</p><a class="text-link" href={withBase(routeFor("about",lang))}>{t.aboutLink} ↗</a></div></section>
  <section class="inquiry-decision"><div class="chapter inquiry-decision__inner"><div><p class="eyebrow" style="color:#fff">{ar?"الخطوة التالية":"The next step"}</p><h2>{t.final}</h2></div><div><p>{t.finalCopy}</p><a class="button" href={withBase(routeFor("contact",lang))}>{t.start}</a></div></div></section>
</BaseLayout>
<script>
const play=document.querySelector('.media-play');const video=document.querySelector('#identity-film');if(play instanceof HTMLButtonElement&&video instanceof HTMLVideoElement){play.addEventListener('click',()=>{const src=video.dataset.src;if(src&&!video.src)video.src=src;video.hidden=false;play.hidden=true;video.play();});}
</script>
