---
import {siteData,whatsappLinks} from "../data/site";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};
---
<footer class="site-footer"><div class="site-footer__inner"><div><p class="eyebrow">{lang==="ar"?"من رام الله إلى العالم":"From Ramallah to the world"}</p><h2>{lang==="ar"?"قصص متجذرة. أنظمة قابلة للاستخدام.":"Grounded stories. Usable systems."}</h2></div><div><strong>{lang==="ar"?"ابدأ من هنا":"Start here"}</strong><p><a href={withBase(routeFor("contact",lang))}>{lang==="ar"?"أرسل موجزاً":"Send a brief"}</a></p><p><a href={`mailto:${siteData.email}`}>{siteData.email}</a></p><p><a href={whatsappLinks.primary} target="_blank" rel="noopener noreferrer">{lang==="ar"?"واتساب الرئيسي":"Primary WhatsApp"}</a></p><p><a href={whatsappLinks.secondary} target="_blank" rel="noopener noreferrer">{lang==="ar"?"واتساب البديل":"Secondary WhatsApp"}</a></p></div><div><strong>{lang==="ar"?"روابط عامة":"Public channels"}</strong><div class="footer-links"><a href={siteData.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={siteData.social.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a href={siteData.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={siteData.social.pinterest} target="_blank" rel="noopener noreferrer">Pinterest</a><a href={siteData.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a><a href={siteData.social.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={siteData.social.superteam} target="_blank" rel="noopener noreferrer">Superteam</a></div><div class="footer-privacy"><a href={withBase(routeFor("privacy",lang))}>{lang==="ar"?"الخصوصية والتحليلات":"Privacy & analytics"}</a><button type="button" data-analytics-settings>{lang==="ar"?"إعدادات التحليلات":"Analytics settings"}</button></div></div></div><div class="chapter footer-note">© {new Date().getFullYear()} Tamer Mansour · Ramallah — Remote · {lang==="ar"?"العربية والإنجليزية":"Arabic + English"}</div></footer>
