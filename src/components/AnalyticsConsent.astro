---
import { siteData } from "../data/site";
import { routeFor, type Locale } from "../data/locale";
import { withBase } from "../utils/withBase";

const { lang = "en" } = Astro.props as { lang?: Locale };
const ar = lang === "ar";
const measurementId = siteData.analyticsMeasurementId;
---

<section class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
  <div class="analytics-consent__copy">
    <p class="eyebrow">{ar ? "اختيارك مهم" : "Your choice matters"}</p>
    <h2 id="analytics-consent-title">{ar ? "هل تسمح بتحليلات مجهولة؟" : "Allow anonymous analytics?"}</h2>
    <p>
      {ar
        ? "تساعدني Google Analytics على فهم الصفحات المفيدة. لن تُحمّل إلا بعد موافقتك، ولا أرسل اسمك أو بريدك أو نصوص النموذج."
        : "Google Analytics helps me understand which pages are useful. It loads only after you accept, and I never send your name, email, or form text."}
      <a href={withBase(routeFor("privacy", lang))}>{ar ? "اقرأ سياسة الخصوصية" : "Read the privacy note"}</a>.
    </p>
  </div>
  <div class="analytics-consent__actions">
    <button class="button" type="button" data-analytics-accept>{ar ? "السماح بالتحليلات" : "Accept analytics"}</button>
    <button class="button button--ghost" type="button" data-analytics-decline>{ar ? "رفض" : "Decline"}</button>
  </div>
</section>

<div class="analytics-toast" data-analytics-toast role="status" aria-live="polite" hidden></div>

<script is:inline define:vars={{ measurementId }}>
  (() => {
    const consentKey = "tm_analytics_consent_v1";
    const panel = document.querySelector("[data-analytics-consent]");
    const toast = document.querySelector("[data-analytics-toast]");
    const isArabic = document.documentElement.lang === "ar";
    let choice = localStorage.getItem(consentKey);

    const showToast = (message) => {
      if (!(toast instanceof HTMLElement)) return;
      toast.textContent = message;
      toast.hidden = false;
      window.setTimeout(() => { toast.hidden = true; }, 3500);
    };

    const setPanelVisible = (visible, moveFocus = false) => {
      if (!(panel instanceof HTMLElement)) return;
      panel.hidden = !visible;
      if (visible && moveFocus) {
        const firstButton = panel.querySelector("button");
        if (firstButton instanceof HTMLButtonElement) firstButton.focus();
      }
    };

    const analyticsAllowed = () => localStorage.getItem(consentKey) === "granted";

    const loadAnalytics = () => {
      if (document.getElementById("tm-ga4")) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag("consent", "default", {
        analytics_storage: "granted",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted"
      });
      window.gtag("js", new Date());
      window.gtag("config", measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false
      });
      const script = document.createElement("script");
      script.id = "tm-ga4";
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      document.head.append(script);
    };

    const clearAnalyticsCookies = () => {
      for (const cookie of document.cookie.split(";")) {
        const name = cookie.split("=")[0]?.trim();
        if (name && (name === "_ga" || name.startsWith("_ga_"))) {
          document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        }
      }
    };

    const grant = () => {
      localStorage.setItem(consentKey, "granted");
      choice = "granted";
      loadAnalytics();
      setPanelVisible(false);
      showToast(isArabic ? "تم تفعيل التحليلات. يمكنك تغيير اختيارك من التذييل." : "Analytics enabled. You can change this in the footer.");
    };

    const deny = () => {
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied"
        });
      }
      localStorage.setItem(consentKey, "denied");
      choice = "denied";
      clearAnalyticsCookies();
      setPanelVisible(false);
      showToast(isArabic ? "لن يتم تحميل Google Analytics." : "Google Analytics will not be loaded.");
    };

    document.querySelector("[data-analytics-accept]")?.addEventListener("click", grant);
    document.querySelector("[data-analytics-decline]")?.addEventListener("click", deny);
    document.querySelectorAll("[data-analytics-settings]").forEach((button) => {
      button.addEventListener("click", () => setPanelVisible(true, true));
    });

    document.addEventListener("click", (event) => {
      if (!analyticsAllowed() || typeof window.gtag !== "function") return;
      const target = event.target instanceof Element ? event.target.closest("a[href]") : null;
      if (!(target instanceof HTMLAnchorElement)) return;
      const href = target.href;
      const method = href.startsWith("mailto:") ? "email" : /(?:wa\.me|whatsapp\.com)/i.test(href) ? "whatsapp" : null;
      if (method) window.gtag("event", "contact_intent", { method, page_path: location.pathname });
    });

    window.addEventListener("tm:lead", (event) => {
      if (!analyticsAllowed() || typeof window.gtag !== "function") return;
      const leadType = event instanceof CustomEvent && typeof event.detail?.leadType === "string" ? event.detail.leadType : "unspecified";
      window.gtag("event", "generate_lead", { lead_type: leadType });
    });

    if (choice === "granted") loadAnalytics();
    else if (choice !== "denied") setPanelVisible(true);
  })();
</script>
