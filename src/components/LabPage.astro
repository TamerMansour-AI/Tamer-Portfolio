---
import BaseLayout from "../layouts/BaseLayout.astro";import {labItems} from "../data/portfolio";import {routeFor,type Locale} from "../data/locale";import {withBase} from "../utils/withBase";const {lang="en"}=Astro.props as {lang?:Locale};const ar=lang==="ar";
---
<BaseLayout title={ar?"المختبر | تجارب تامر منصور":"Lab | Tamer Mansour Experiments"} description={ar?"تجارب ونماذج وأرشيفات ثانوية توضح ما تم اختباره وما تم تعلمه.":"Experiments, prototypes, and archives showing what was tested and learned."} path={routeFor("lab",lang)} lang={lang} dir={ar?"rtl":"ltr"} pageType="CollectionPage">
<header class="page-hero chapter"><p class="eyebrow">{ar?"مختبر ثانوي، فضول واضح":"Secondary lab, visible curiosity"}</p><h1>{ar?"التجارب هنا. الأعمال الرئيسية هناك.":"Experiments live here. Flagships lead elsewhere."}</h1><p>{ar?"يفصل المختبر بين الاستكشاف والدليل المهني، ويجعل نضج كل فكرة وما تم تعلمه واضحين.":"The Lab separates exploration from professional proof and makes each idea’s maturity and learning explicit."}</p></header>
<section class="section chapter lab-grid">{labItems.map(item=><article class="lab-item">{"media" in item&&<img class="lab-item__media" src={withBase(item.media)} alt={item.mediaAlt[lang]} loading="lazy" width="720" height="480" />}<p class="status">{item.status[lang]} / {item.date}</p><h2>{item.title[lang]}</h2><h3>{ar?"ما تم اختباره":"What was tested"}</h3><p>{item.tested[lang]}</p><h3>{ar?"ما تم تعلمه":"What was learned"}</h3><p>{item.learned[lang]}</p>{"url" in item&&item.url&&<a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{ar?"افتح الرابط العام":"Open public link"} ↗</a>}</article>)}</section>
<section class="archive-invitation"><div class="chapter"><p class="eyebrow">{ar ? "المواد المحفوظة" : "Retained evidence"}</p><h2>{ar ? "المشاريع والصور والروابط الأوسع موجودة في الأرشيف." : "The wider projects, images, and public links live in the archive."}</h2><a class="button button--light" href={withBase(routeFor("archive", lang))}>{ar ? "افتح الأرشيف" : "Open the archive"}</a></div></section>
</BaseLayout>
